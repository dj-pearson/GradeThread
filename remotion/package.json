{
  "name": "gradethread-remotion",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion compositions for GradeThread + FlipDesk product-guide videos",
  "scripts": {
    "dev": "remotion studio",
    "render:gradethread": "remotion render src/index.ts GradeThreadGuide out/gradethread-guide.mp4",
    "render:flipdesk": "remotion render src/index.ts FlipDeskGuide out/flipdesk-guide.mp4",
    "render:all": "npm run render:gradethread && npm run render:flipdesk"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
