<?xml version="1.0" encoding="UTF-8"?>
<lint>
    <!--
      US-3010 AC10. Two CompositionLocals, both provided by GradeThreadTheme and
      read only by the status-colour resolvers in StatusColor.kt.

      LocalIsDarkTheme exists because GradeThreadTheme takes darkTheme as a
      PARAMETER: every screenshot test passes it explicitly while Robolectric's
      system setting stays light, so isSystemInDarkTheme() would return a light
      colour inside a golden captured as dark. LocalHighContrast carries an
      accessibility setting that has no other route down the tree.

      Passing either as a parameter would mean threading it through every
      composable between the theme and a grade badge. detekt carries the same
      allowlist in config/detekt/detekt.yml; the two must agree.
    -->
    <issue id="ComposeCompositionLocalUsage">
        <option name="allowed-composition-locals" value="LocalIsDarkTheme,LocalHighContrast" />
    </issue>
</lint>
