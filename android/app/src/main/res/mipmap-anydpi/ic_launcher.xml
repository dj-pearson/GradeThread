<?xml version="1.0" encoding="utf-8"?>
<!--
  US-1381: adaptive launcher icon.

  In `mipmap-anydpi` with no `-v26` qualifier on purpose: minSdk is 26, so the
  adaptive-icon element always parses, and a version-qualified folder with no
  unqualified fallback is a resource with no default declaration.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
