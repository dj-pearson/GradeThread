<?xml version="1.0" encoding="utf-8"?>
<!--
  US-1393: the languages this app ships.

  Android 13+ reads this to build the per-app language picker in system
  settings; AppCompat reads it below 13. A locale listed here with no
  values-<tag>/ directory falls back to the default, which is worse than not
  listing it: the picker offers a language and nothing changes. So this list
  grows only when a translation lands.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="es" />
</locale-config>
