<?xml version="1.0" encoding="utf-8"?>
<!--
  US-1335: the only path the camera is granted. Scoped to the single cache
  subdirectory Snap writes into, NOT the whole cache — a FileProvider root of
  "." would hand any app we send an intent to a URI it could point at staged
  uploads or the OCR stash.
-->
<paths>
    <cache-path name="snap-capture" path="snap-capture/" />
    <!--
      US-2412: the staged account export, shared out through the system sheet.
      Its own subdirectory for the same reason as above — this file is the
      subject's entire account, and a wider root would let any app we hand a
      URI to reach for it.
    -->
    <cache-path name="account-export" path="account-export/" />
</paths>
