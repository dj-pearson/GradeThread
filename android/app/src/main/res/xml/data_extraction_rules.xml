<?xml version="1.0" encoding="utf-8"?>
<!--
  What Android may copy off this device, on Android 12 and higher.

  `android:allowBackup="false"` in the manifest disables Google Drive backup on
  every version, and on 12+ that is ALL it disables: device-to-device transfer
  keeps running unless a rule says otherwise. That is not a theoretical gap for
  this app. The Room store holds inventory, sales, payouts and captures that
  have not synced yet, in plain SQLite, and `gradethread.workspace` holds which
  tenant the seller was last acting as.

  So: nothing leaves, by either route. The local store is a MIRROR - the same
  reasoning DatabaseProvider destroys and rebuilds it on - and the server refills
  it on the first sync after sign-in. Carrying a stale copy onto a new phone
  buys nothing and moves a seller's books somewhere they did not decide to put
  them.

  The session itself was never transferable: it lives in
  EncryptedSharedPreferences under a Keystore key that cannot leave the device,
  so the bytes would arrive undecryptable. These rules are about everything
  ELSE, which is not encrypted at all.
-->
<data-extraction-rules>
    <!--
      `root` is the app's data directory, and file/database/sharedpref all live
      under it, so excluding root covers every one of them. `external` is the
      app's external-storage directory.

      The `device_*` domains, which name the direct-boot-aware tree, are
      deliberately NOT listed. Nothing in this app writes there: there is no
      `createDeviceProtectedStorageContext` call and no `directBootAware`
      component, so that tree is empty and an exclude for it would be a rule
      covering nothing. Listing a domain that buys nothing is not free - it is
      one more line to be wrong about in a file whose mistakes are silent.
    -->
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
