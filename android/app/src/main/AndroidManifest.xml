<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- US-1322: the connectivity monitor (sync/offline status + debounced flush). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- US-1324: photo-first capture. Camera is optional hardware - the app
         works (photo import, everything else) on camera-less devices. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- US-1331: hands-free dictation for item notes. Optional hardware -
         the notes field is fully usable by typing on mic-less devices. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- US-1378: push. Requested at a MONEY MOMENT (first sale / first grade),
         never at launch - Android gives one real shot at this dialog. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- US-2492: Sourcing Radar centres its list on where the phone is.
         COARSE ONLY, and deliberately: the server keeps roughly a one-kilometre
         cell, and the client rounds the viewport to 0.05 degrees before it
         leaves the device, so a fine fix would be thrown away twice on the way
         out. Requested from the "Use my location" button, never on open - the
         first list is built from the seller's own linked stores, so Radar works
         with this permission refused. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- US-1331: package visibility (API 30+). Without this, the recognition
         service is invisible to us and isRecognitionAvailable() reports false
         on a device that can dictate perfectly well. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <!-- US-2891: `enableOnBackInvokedCallback` is set EXPLICITLY, not left to
         the default, because the default changes underneath us. Targeting API
         36 turns predictive back on regardless, and on 33-35 the default is
         off — so leaving it unset would mean an Android 14 phone and an
         Android 16 phone handling back differently in the same build, which is
         the kind of split nobody reproduces.

         Safe here because the app has NO legacy back handling to break: zero
         `onBackPressed` overrides, zero `KEYCODE_BACK` reads, zero
         `BackHandler` calls in 688 Kotlin files. Back is entirely
         Navigation-Compose's, and androidx.activity already bridges its
         dispatcher to `OnBackInvokedCallback`. The flag makes the app eligible
         for the system's back-to-home and cross-activity animations; the
         in-app predictive transitions are US-2911's work, not this line's.

         Lint files it as `UnusedAttribute` (API 33+, minSdk 26) and it is in
         lint-baseline.xml alongside the three identical precedents -
         `localeConfig` (33+) and the widget's `targetCellWidth`/`Height`
         (31+). Lint's own explanation is why that is the right call rather
         than a suppression: "this is not an error; the application will
         simply ignore the attribute". -->
    <application
        android:name=".GradeThreadApp"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.GradeThread">
        <!-- US-1308: Sentry initializes manually from AppConfig (DSN may be
             absent → silently disabled); the auto-init provider must not race it. -->
        <meta-data android:name="io.sentry.auto-init" android:value="false" />

        <!-- US-1393: below Android 13 there is no system per-app language
             store, so AppCompat persists the choice itself. Without this
             service entry the selection survives until the process dies and
             then silently reverts, which reads as the setting not working. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- US-1378: FCM. There is deliberately no google-services plugin and
             no google-services.json - that plugin fails the build outright when
             the file is absent, which would stop anyone building this app
             without Firebase credentials that aren't ours to commit. Firebase
             is initialized by hand from BuildConfig (PushConfig), the same
             DSN-gated shape Sentry uses. -->
        <service
            android:name=".platform.push.GradeThreadMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- Not exported: only our own notification actions target it. -->
        <receiver
            android:name=".platform.push.PushActionReceiver"
            android:exported="false" />

        <!-- US-1380: the home-screen widget. Exported because the launcher
             (a different app) is what binds and updates it. It carries no
             action of its own beyond redrawing from the stored snapshot. -->
        <receiver
            android:name=".widget.SellerSnapshotWidgetReceiver"
            android:label="@string/widget_snapshot_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/seller_snapshot_widget_info" />
        </receiver>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.GradeThread">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- US-1314: widget taps. The `widget` host is deliberately
                 distinct from `auth-callback`, so these can never be mistaken
                 for OAuth redirects (AC4 precedence by construction). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="com.gradethread.app"
                    android:host="widget" />
                <!-- US-1381: launcher shortcuts. The custom scheme, not the
                     https link: App Links are only verified on the release
                     build, so a static shortcut carrying an https Uri opens a
                     browser on a debug build. -->
                <data
                    android:scheme="com.gradethread.app"
                    android:host="shortcut" />
            </intent-filter>
            <!-- US-1314: verified App Links for content destinations. Listed
                 per-subpath (NOT a /app prefix) so /app/auth-callback keeps
                 routing exclusively to AuthCallbackActivity. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="gradethread.com" />
                <data android:pathPrefix="/app/item" />
                <data android:pathPrefix="/app/inventory" />
                <data android:pathPrefix="/app/sales" />
                <data android:pathPrefix="/app/marketplaces" />
                <data android:pathPrefix="/app/reconnect" />
                <data android:pathPrefix="/app/negotiation" />
                <data android:pathPrefix="/app/grades" />
                <data android:pathPrefix="/app/support" />
                <data android:pathPrefix="/app/capture" />
                <data android:pathPrefix="/app/add" />
                <!-- US-2898: this was missing while DeepLinkRoute had parsed
                     /app/shipping since US-1377, so the link opened a BROWSER
                     and the seller landed on the website. The same destination
                     via the widget (com.gradethread.app://widget/shipping)
                     worked, because the widget host is claimed below — one of
                     the two routes to the shipping queue worked and the other
                     silently did not.

                     DeepLinkRouteManifestTest now compares this list against
                     DeepLinkRoute in BOTH directions, so the two cannot drift
                     again. -->
                <data android:pathPrefix="/app/shipping" />
                <!-- US-1350: the eBay consent bounce-back. Claimed via
                     assetlinks.json so no other app can intercept it. -->
                <data android:pathPrefix="/app/oauth/ebay" />
            </intent-filter>
            <!-- US-1381: static long-press shortcuts + the Assistant capability
                 declarations. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
        <!-- US-1382: "Share to GradeThread". Its own Activity because the
             system hands a share to a component and expects it back promptly;
             it stages the photos and finishes, and the app drains them on next
             foreground. excludeFromRecents so a finished share doesn't sit in
             the task switcher looking like an open screen. -->
        <activity
            android:name=".intake.ShareTargetActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/share_target_label"
            android:theme="@style/Theme.GradeThread">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- US-1311: the OAuth return point. The App Link is domain-bound via
             assetlinks.json (US-661's Android half); the custom scheme is the
             pre-App-Link fallback — the activity validates BOTH against a
             strict allowlist before touching auth. -->
        <activity
            android:name=".auth.AuthCallbackActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.GradeThread">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="gradethread.com"
                    android:path="/app/auth-callback" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="com.gradethread.app"
                    android:host="auth-callback" />
            </intent-filter>
        </activity>
        <!-- US-1328: disable WorkManager's default initializer so the
             Configuration.Provider (3-thread upload cap) takes effect. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                tools:node="remove" />
        </provider>
        <!-- US-1335: hands the system camera a scoped content:// grant to write
             into our own cache. Deliberately NOT shared external storage — a
             garment photo the user has not chosen to publish must not be
             readable by every other app on the device. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
