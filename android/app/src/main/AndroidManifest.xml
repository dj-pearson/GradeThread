<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- US-1322: the connectivity monitor (sync/offline status + debounced flush). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".GradeThreadApp"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.GradeThread">
        <!-- US-1308: Sentry initializes manually from AppConfig (DSN may be
             absent → silently disabled); the auto-init provider must not race it. -->
        <meta-data android:name="io.sentry.auto-init" android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.GradeThread">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- US-1314: widget taps. The `widget` host is deliberately
                 distinct from `auth-callback`, so these can never be mistaken
                 for OAuth redirects (AC4 precedence by construction). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="com.gradethread.app"
                    android:host="widget" />
            </intent-filter>
            <!-- US-1314: verified App Links for content destinations. Listed
                 per-subpath (NOT a /app prefix) so /app/auth-callback keeps
                 routing exclusively to AuthCallbackActivity. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="gradethread.com" />
                <data android:pathPrefix="/app/item" />
                <data android:pathPrefix="/app/inventory" />
                <data android:pathPrefix="/app/sales" />
                <data android:pathPrefix="/app/marketplaces" />
                <data android:pathPrefix="/app/reconnect" />
                <data android:pathPrefix="/app/negotiation" />
                <data android:pathPrefix="/app/grades" />
                <data android:pathPrefix="/app/support" />
                <data android:pathPrefix="/app/capture" />
                <data android:pathPrefix="/app/add" />
            </intent-filter>
        </activity>
        <!-- US-1311: the OAuth return point. The App Link is domain-bound via
             assetlinks.json (US-661's Android half); the custom scheme is the
             pre-App-Link fallback — the activity validates BOTH against a
             strict allowlist before touching auth. -->
        <activity
            android:name=".auth.AuthCallbackActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.GradeThread">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="gradethread.com"
                    android:path="/app/auth-callback" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="com.gradethread.app"
                    android:host="auth-callback" />
            </intent-filter>
        </activity>
    </application>

</manifest>
