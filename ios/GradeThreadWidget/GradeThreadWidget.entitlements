<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.gradethread.app</string>
    </array>
    <!-- US-1015: Data Protection floor. Mirrors the main app
         (GradeThread.entitlements, US-658) and ShareExtension so any file the
         widget extension materializes from the shared App Group container
         defaults to NSFileProtectionCompleteUntilFirstUserAuthentication
         rather than the weaker .none class. "Until first user authentication"
         (not "complete") keeps reads working after the first post-boot unlock
         so timeline refreshes don't fail on a locked device. -->
    <key>com.apple.developer.default-data-protection</key>
    <string>NSFileProtectionCompleteUntilFirstUserAuthentication</string>
</dict>
</plist>
