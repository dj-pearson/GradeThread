<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.developer.applesignin</key>
    <array>
        <string>Default</string>
    </array>
    <!-- US-187: APNs. Committed as "development" so local Xcode-signed
         builds talk to the APNs sandbox. The release workflow
         (ios-release.yml, "Flip aps-environment to production" step)
         rewrites this to "production" with PlistBuddy before archiving,
         so TestFlight + App Store builds always ship with the production
         gateway. Don't flip this file manually — let the workflow do it. -->
    <key>aps-environment</key>
    <string>development</string>
    <!-- US-189: Share Extension writes intake-staging files to this
         App Group container; the main app reads them on next launch.
         Both targets must declare the same group string. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.gradethread.app</string>
    </array>
    <!-- US-658: Data Protection. Encrypts files written by the app at rest —
         including SwiftData's SQLite store (the local mirror of inventory /
         sales / payout figures) — keyed to the device passcode. "Until first
         user authentication" (not "complete") so Background App Refresh + the
         widget can still read after the first post-boot unlock. -->
    <key>com.apple.developer.default-data-protection</key>
    <string>NSFileProtectionCompleteUntilFirstUserAuthentication</string>
</dict>
</plist>
