<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <!-- US-193: enable multi-window on iPad via UISceneSession.
         UIApplicationSupportsMultipleScenes=YES lets users open the
         inventory in one window and an item detail in another via
         the App Switcher. SwiftUI's WindowGroup handles the rest;
         no SceneDelegate needed. -->
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <true/>
        <key>UISceneConfigurations</key>
        <dict/>
    </dict>
    <!-- US-188: opportunistic background sync via BGAppRefreshTask. The
         identifier must match the one BGTaskScheduler registers at launch;
         iOS rejects schedule requests for identifiers not declared here. -->
    <key>UIBackgroundModes</key>
    <array>
        <string>fetch</string>
        <string>processing</string>
    </array>
    <key>BGTaskSchedulerPermittedIdentifiers</key>
    <array>
        <string>com.gradethread.app.refresh</string>
    </array>
    <!-- Camera covers two capture surfaces: garment photos for grading
         (US-173) and SKU barcode scanning on the manual intake form
         (US-179). Single string covers both because iOS only shows the
         first prompt. -->
    <!-- Surfaced from the active .xcconfig so AppConfig can read them at
         runtime. The xcconfig escapes // in URLs as /$()/ — the build
         system resolves that to a valid https:// URL before we see it. -->
    <key>SUPABASE_URL</key>
    <string>$(SUPABASE_URL)</string>
    <key>SUPABASE_ANON_KEY</key>
    <string>$(SUPABASE_ANON_KEY)</string>
    <key>EDGE_API_URL</key>
    <string>$(EDGE_API_URL)</string>
    <!-- US-191 telemetry. Empty strings disable each SDK silently —
         both are opt-in best-effort. -->
    <key>SENTRY_DSN</key>
    <string>$(SENTRY_DSN)</string>
    <key>POSTHOG_API_KEY</key>
    <string>$(POSTHOG_API_KEY)</string>
    <key>POSTHOG_HOST</key>
    <string>$(POSTHOG_HOST)</string>
    <!-- Voice dictation in the manual intake form (US-179). -->
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>GradeThread uses speech recognition so you can dictate notes hands-free while sourcing items.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>GradeThread needs the microphone to capture your voice for dictation.</string>
    <!-- Thrift Radar, two separate uses: CONTRIBUTING (US-1861, requested from
         the Settings switch, default off) and LOOKING (US-1866, requested from
         the Radar view's "Use my location" button). Mirrored from project.yml's
         info.properties, which is the build's source of truth. -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>GradeThread uses your location for Thrift Radar: to show which stores near you are busy, and — only if you switch on contributions — to place a scan in a rough area about a kilometre across. Your exact position is never stored.</string>
    <!-- Camera + photo-library + Face ID usage strings. The build's source of
         truth is project.yml's info.properties (XcodeGen regenerates this file
         from it); these are mirrored here verbatim so a manual archive that
         skips `xcodegen generate` can't ship without them and crash on first
         camera/photo access. Keep in sync with project.yml. -->
    <key>NSCameraUsageDescription</key>
    <string>GradeThread uses the camera to capture garment photos for grading and to scan SKU barcodes when cataloging items.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>GradeThread imports photos from your library so you can grade existing garment shots.</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>GradeThread saves your certified graded photo to your library so you can post it with your listings.</string>
    <key>NSFaceIDUsageDescription</key>
    <string>GradeThread can use Face ID to lock the app so your sales, payouts, and account stay private.</string>
    <!-- Custom URL scheme so Supabase OAuth redirects (Google + the eventual
         magic-link flow) come back to the app instead of staying in Safari.
         Matches supabaseRedirectURL in AppConfig. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>CFBundleURLName</key>
            <string>com.gradethread.app.oauth</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>com.gradethread.app</string>
            </array>
        </dict>
    </array>
    <!-- US-3101: long-press the app icon. The three things a reseller does most
         from a standing start, in the order they do them: work out whether to
         buy it, record what they bought, and hunt for the next one. Each one
         used to begin with opening the app and then finding a grid icon. -->
    <key>UIApplicationShortcutItems</key>
    <array>
        <dict>
            <key>UIApplicationShortcutItemType</key>
            <string>com.gradethread.app.shortcut.prospect</string>
            <key>UIApplicationShortcutItemTitle</key>
            <string>What's it worth?</string>
            <key>UIApplicationShortcutItemSubtitle</key>
            <string>Photograph an item for comps</string>
            <key>UIApplicationShortcutItemIconType</key>
            <string>UIApplicationShortcutIconTypeCapturePhoto</string>
        </dict>
        <dict>
            <key>UIApplicationShortcutItemType</key>
            <string>com.gradethread.app.shortcut.addItem</string>
            <key>UIApplicationShortcutItemTitle</key>
            <string>Add an item</string>
            <key>UIApplicationShortcutItemIconType</key>
            <string>UIApplicationShortcutIconTypeAdd</string>
        </dict>
        <dict>
            <key>UIApplicationShortcutItemType</key>
            <string>com.gradethread.app.shortcut.scout</string>
            <key>UIApplicationShortcutItemTitle</key>
            <string>Scout deals</string>
            <key>UIApplicationShortcutItemSubtitle</key>
            <string>Find underpriced listings</string>
            <key>UIApplicationShortcutItemIconType</key>
            <string>UIApplicationShortcutIconTypeSearch</string>
        </dict>
    </array>
</dict>
</plist>
