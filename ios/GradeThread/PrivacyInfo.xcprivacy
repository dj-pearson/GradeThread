<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  App privacy manifest (US-197). Apple requires this file for App Store
  submission and uses it to auto-populate part of the privacy nutrition
  labels. Keep it in lock-step with the App Privacy disclosures in App
  Store Connect — see ios/fastlane/metadata/PRIVACY_LABELS.md for the
  human-readable mapping + which SDK collects what.

  We do NOT track users across apps/sites: NSPrivacyTracking=false and no
  tracking domains. PostHog analytics is opt-out, on by default (the user
  can disable it in Settings) + scoped to this app, so it's "collected, not
  linked for tracking" rather than "used for tracking".
-->
<plist version="1.0">
<dict>
    <key>NSPrivacyTracking</key>
    <false/>
    <key>NSPrivacyTrackingDomains</key>
    <array/>

    <key>NSPrivacyCollectedDataTypes</key>
    <array>
        <!-- Account email — used to sign in + contact the seller. Linked
             to identity, never used for cross-app tracking. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeEmailAddress</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
        <!-- Display name on the account profile. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeName</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
        <!-- Purchase History (Apple's "Purchases" category). Covers BOTH:
             (1) the sales + payouts the user records/imports for reseller
             bookkeeping, AND (2) StoreKit in-app purchases (grading credits +
             FlipDesk subscriptions, US-786) tied to the account. There is no
             separate "in-app purchases" data type in the privacy-manifest
             schema — PurchaseHistory is the one purchase type, so both map here.
             Linked to identity, App Functionality, never used for tracking. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypePurchaseHistory</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
        <!-- Garment photos captured / imported for cataloging + grading. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypePhotosorVideos</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
        <!-- Sentry crash + diagnostic data. NOT linked to identity (we
             stamp a Sentry uid but no email per the Telemetry facade). -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeCrashData</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <false/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
        <!-- PostHog product-analytics events. Opt-out, on by default
             (user can disable in Settings → Analytics); not linked to
             identity for tracking. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeProductInteraction</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <false/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
            </array>
        </dict>
        <!-- Thrift Radar. COARSE location, and still genuinely OPT-IN — but
             there are now TWO uses, and only the first one COLLECTS anything:

             1. CONTRIBUTING (US-1861). The "Contribute to Thrift Radar" switch
                defaults to false, the app does not call CoreLocation for a scan
                until it is on, and the permission is requested from that switch
                rather than from a scan. This is the use this row declares.
             2. LOOKING (US-1866). The Radar view can centre its nearby list on
                the phone, and asks for the permission in that flow — never on
                appear, never from a scan. That position never leaves the device
                as a position: it becomes a quantized bounding box (a few km a
                side, snapped to a grid) that selects which venues to return.
                Nothing is stored, and looking never enrols anybody as a
                contributor — the consents are separate on purpose.

             The row stays as it is because (2) collects nothing; if a viewing
             position is ever retained, this manifest and PRIVACY_LABELS.md must
             change before that build ships.

             NOT linked to identity: the server replaces the account with a
             weekly-rotating salted digest and stores a ~1 km cell, never the
             fix. App Functionality rather than Analytics, because the map IS the
             feature the user turned on, not measurement of it. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeCoarseLocation</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <false/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
    </array>

    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <!-- UserDefaults — opt-in toggles, notification prefs, review-
             prompt counters. Reason CA92.1: access info from the same app. -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>
            </array>
        </dict>
        <!-- File timestamps — IntakeInbox manifests + App Group snapshot
             ordering. Reason C617.1: timestamps for files inside the
             app's container. -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>C617.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
