// Debug build configuration (local sim runs, CI test job).
//
// Substitution syntax in URLs needs the // escaped so the build setting
// parser doesn't see it as a comment delimiter.

SUPABASE_URL = https:/$()/api.gradethread.com
EDGE_API_URL = https:/$()/functions.gradethread.com

// Non-secret dummy so the app launches in the CI test job + local sim
// (AppConfig fatal-errors on an empty or "REPLACE_ME..." value). The real
// anon key is injected at release time from Infisical — see the Archive
// step in .github/workflows/ios-release.yml. For local runs against the
// real backend, override this in an untracked local xcconfig.
SUPABASE_ANON_KEY = ci-debug-anon-key-placeholder

// US-368: blank for local sim / CI — captcha enforcement is off on the local
// throwaway stack, so the native Turnstile step no-ops. For local runs against
// the real captcha-enforcing backend, override this in an untracked xcconfig.
TURNSTILE_SITE_KEY =

// US-191 telemetry. Empty values disable the corresponding SDK
// silently — analytics + crash reporting are opt-in best-effort.
SENTRY_DSN =
POSTHOG_API_KEY =
POSTHOG_HOST = https:/$()/us.i.posthog.com
