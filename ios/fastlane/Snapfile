# fastlane snapshot config (US-197). Captures App Store screenshots by
# driving the GradeThreadUITests target across the device sizes Apple
# requires for an iPhone + iPad universal app.
#
# Run with:  cd ios && bundle exec fastlane screenshots
#
# Requires the .xcodeproj to exist first (CI runs `xcodegen generate`;
# locally run it manually).

# Device → App Store slot mapping (portrait; iPad runs landscape in-test):
#   iPhone 16 Pro Max      → 1320 x 2868 native (6.9" slot); the 6.5" slot
#                            set (1284 x 2778) is derived from these by
#                            Scripts/make-appstore-sizes.sh after capture.
#   iPad Pro 13-inch (M4)  → 2064 x 2752 / 2752 x 2064 native (13" slot,
#                            accepted as-is — no post-processing).
#
# Older simulators (iPhone 15*, iPad Pro 12.9") no longer ship with current
# Xcode runtimes — don't reference them or fresh CI runners fail. Override
# per-run without editing this file via SNAPSHOT_DEVICES="A,B".
devices((ENV["SNAPSHOT_DEVICES"] || "iPhone 16 Pro Max,iPad Pro 13-inch (M4)").split(","))

languages(["en-US"])

# Dedicated screenshot scheme XcodeGen produces (keeps the UI tests out
# of the unit-test CI action). See ios/project.yml schemes:.
scheme("GradeThreadScreenshots")

# Re-create the simulator status bar with full bars + 100% battery +
# a clean clock so screenshots look polished.
override_status_bar(true)

# Stop on the first failure so a broken nav flow doesn't silently ship
# half-captured screenshots.
stop_after_first_error(true)

# The sign-in flow does real network auth against api.gradethread.com;
# parallel simulators make that flaky and can trip auth rate limits.
concurrent_simulators(false)

# Where deliver picks them up from.
output_directory("./fastlane/screenshots")

clear_previous_screenshots(true)

# The UI test sets the launch argument; snapshot also injects its own.
launch_arguments(["-uiTestScreenshots YES"])
