{
  "ci": {
    "collect": {
      "startServerCommand": "npx vite preview --port 4173 --strictPort",
      "startServerReadyPattern": "Local",
      "url": [
        "http://localhost:4173/",
        "http://localhost:4173/how-it-works",
        "http://localhost:4173/pricing",
        "http://localhost:4173/for-resellers",
        "http://localhost:4173/condition-grading",
        "http://localhost:4173/grading-standard",
        "http://localhost:4173/transparency",
        "http://localhost:4173/faq",
        "http://localhost:4173/verify",
        "http://localhost:4173/whats-it-worth",
        "http://localhost:4173/developers",
        "http://localhost:4173/grading/nwt",
        "http://localhost:4173/grading/fabric-condition"
      ],
      "numberOfRuns": 1,
      "settings": {
        "formFactor": "mobile",
        "skipAudits": ["robots-txt"],
        "screenEmulation": { "mobile": true, "width": 412, "height": 823, "deviceScaleFactor": 1.75, "disabled": false },
        "throttling": {
          "rttMs": 150,
          "throughputKbps": 1638.4,
          "cpuSlowdownMultiplier": 4,
          "requestLatencyMs": 562.5,
          "downloadThroughputKbps": 1474.56,
          "uploadThroughputKbps": 675
        },
        "emulatedUserAgent": "Mozilla/5.0 (Linux; Android 11; moto g power (2022)) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Mobile Safari/537.36"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 4000 }],
        "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 300 }]
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
