{
  "manifest_version": 3,
  "name": "GradeThread: Grade & List",
  "version": "0.3.2",
  "description": "AI condition reads while you shop eBay, Poshmark, Grailed, Mercari, Depop & Vinted — plus cross-listing for FlipDesk sellers.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://gradethread.com/*",
    "https://*.gradethread.com/*",
    "https://*.poshmark.com/*",
    "https://*.mercari.com/*",
    "https://*.grailed.com/*"
  ],
  "externally_connectable": {
    "matches": ["https://gradethread.com/*", "https://*.gradethread.com/*"]
  },
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "GradeThread",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png",
    "256": "icons/icon256.png",
    "512": "icons/icon512.png"
  },
  "content_scripts": [
    {
      "matches": ["https://gradethread.com/*", "https://*.gradethread.com/*"],
      "js": ["gt-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.ebay.com/itm/*",
        "https://*.ebay.co.uk/itm/*",
        "https://*.ebay.de/itm/*",
        "https://*.ebay.ca/itm/*",
        "https://*.ebay.com.au/itm/*",
        "https://*.ebay.fr/itm/*",
        "https://*.ebay.it/itm/*",
        "https://*.ebay.es/itm/*",
        "https://*.ebay.ie/itm/*",
        "https://*.ebay.nl/itm/*",
        "https://*.ebay.at/itm/*",
        "https://*.ebay.ch/itm/*",
        "https://*.ebay.pl/itm/*",
        "https://*.ebay.be/itm/*",
        "https://*.poshmark.com/listing/*",
        "https://*.poshmark.ca/listing/*",
        "https://*.grailed.com/listings/*",
        "https://*.mercari.com/item/*",
        "https://*.mercari.com/us/item/*",
        "https://*.depop.com/products/*",
        "https://*.vinted.com/items/*",
        "https://*.vinted.co.uk/items/*",
        "https://*.vinted.fr/items/*",
        "https://*.vinted.de/items/*",
        "https://*.vinted.es/items/*",
        "https://*.vinted.it/items/*",
        "https://*.vinted.nl/items/*",
        "https://*.vinted.pl/items/*",
        "https://*.vinted.lt/items/*",
        "https://*.vinted.cz/items/*",
        "https://*.vinted.be/items/*",
        "https://*.vinted.at/items/*",
        "https://*.vinted.ro/items/*",
        "https://*.vinted.hu/items/*",
        "https://*.vinted.sk/items/*",
        "https://*.vinted.pt/items/*",
        "https://*.vinted.se/items/*",
        "https://*.vinted.lu/items/*",
        "https://*.vinted.hr/items/*",
        "https://*.vinted.gr/items/*",
        "https://*.vinted.dk/items/*",
        "https://*.vinted.fi/items/*"
      ],
      "js": ["research/selectors.js", "research/image-utils.cjs", "research/marketplace.js"],
      "css": ["research/overlay.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://poshmark.com/*", "https://*.poshmark.com/*"],
      "js": ["lister/selectors.js", "lister/common.js", "lister/poshmark.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.mercari.com/*", "https://*.mercari.com/*"],
      "js": ["lister/selectors.js", "lister/common.js", "lister/mercari.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.grailed.com/*", "https://*.grailed.com/*"],
      "js": ["lister/selectors.js", "lister/common.js", "lister/grailed.js"],
      "run_at": "document_idle"
    }
  ]
}
