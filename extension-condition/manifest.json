{
  "manifest_version": 3,
  "name": "GradeThread Condition Check",
  "version": "0.1.0",
  "description": "Get an independent GradeThread AI condition read on an eBay listing while you shop, so you buy pre-owned clothing with confidence.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://gradethread.com/*",
    "https://*.gradethread.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "GradeThread Condition Check",
    "default_icon": { "128": "icons/icon128.png" }
  },
  "icons": {
    "128": "icons/icon128.png",
    "256": "icons/icon256.png",
    "512": "icons/icon512.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.ebay.com/itm/*",
        "https://www.ebay.co.uk/itm/*",
        "https://www.ebay.de/itm/*",
        "https://www.ebay.ca/itm/*",
        "https://www.ebay.com.au/itm/*"
      ],
      "js": ["selectors.js", "content/ebay-image.cjs", "content/ebay.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
