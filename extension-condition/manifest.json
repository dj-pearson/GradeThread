{
  "manifest_version": 3,
  "name": "GradeThread Condition Check",
  "version": "0.2.0",
  "description": "Get an independent GradeThread AI condition read on a listing while you shop eBay, Poshmark, Grailed, Mercari, Depop, and Vinted — buy pre-owned clothing with confidence.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://gradethread.com/*",
    "https://*.gradethread.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "GradeThread Condition Check",
    "default_icon": { "128": "icons/icon128.png" }
  },
  "icons": {
    "128": "icons/icon128.png",
    "256": "icons/icon256.png",
    "512": "icons/icon512.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.ebay.com/itm/*",
        "https://www.ebay.co.uk/itm/*",
        "https://www.ebay.de/itm/*",
        "https://www.ebay.ca/itm/*",
        "https://www.ebay.com.au/itm/*",
        "https://poshmark.com/listing/*",
        "https://*.poshmark.com/listing/*",
        "https://poshmark.ca/listing/*",
        "https://www.grailed.com/listings/*",
        "https://grailed.com/listings/*",
        "https://www.mercari.com/item/*",
        "https://www.mercari.com/us/item/*",
        "https://www.depop.com/products/*",
        "https://depop.com/products/*",
        "https://www.vinted.com/items/*",
        "https://www.vinted.co.uk/items/*",
        "https://www.vinted.fr/items/*",
        "https://www.vinted.de/items/*",
        "https://www.vinted.es/items/*",
        "https://www.vinted.it/items/*",
        "https://www.vinted.nl/items/*",
        "https://www.vinted.pl/items/*",
        "https://www.vinted.lt/items/*",
        "https://www.vinted.cz/items/*"
      ],
      "js": ["selectors.js", "content/image-utils.cjs", "content/marketplace.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
