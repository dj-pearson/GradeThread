# Supabase
VITE_SUPABASE_URL=https://api.gradethread.com
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Stripe — NOTHING READS THIS. Kept and labelled rather than deleted, the same
# way the unused AI vars are handled in services/edge-functions/.env.example,
# because a var that quietly disappears from an example is a var somebody
# re-adds later. There is no @stripe/stripe-js dependency and no src/ file
# reads it: checkout is a Stripe Checkout URL minted server-side and redirected
# to, so the browser never holds a publishable key. Leaving it unset costs
# nothing. (Known since 2026-08-08; see vault/10-ops/env-reference.md.)
VITE_STRIPE_PUBLISHABLE_KEY=

# Sentry
VITE_SENTRY_DSN=

# PostHog
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# FlipDesk: edge service base URL (consolidated GradeThread + FlipDesk API)
VITE_EDGE_API_URL=https://functions.gradethread.com

# US-368: Cloudflare Turnstile SITE key (public — safe to expose) for the auth
# pages (signup / login / password-reset). When set, the auth forms render the
# Turnstile widget and send a captcha token to GoTrue. Leave UNSET until you also
# enable captcha on the self-hosted GoTrue (GOTRUE_SECURITY_CAPTCHA_ENABLED=true
# + GOTRUE_SECURITY_CAPTCHA_SECRET=<Turnstile SECRET key>) — flip BOTH together or
# auth breaks (GoTrue rejects tokenless calls / the widget is a no-op). Use the
# Turnstile dummy "always-passes" site key 1x00000000000000000000AA to test the UI.
VITE_TURNSTILE_SITE_KEY=

# US-1434: "Continue with Apple" (web) needs GoTrue's Apple provider configured
# with a Services ID client + client-secret JWT and a {origin}/auth/callback
# redirect. Until that prod config is verified, leave this UNSET so the Apple
# button stays hidden (otherwise it errors for every user). Set to "true" only
# after smoke-testing the full Apple web flow against prod. Google sign-in is not
# gated by this flag.
VITE_APPLE_OAUTH_ENABLED=

# Cloudflare Image Resizing (US-306). Set to "true" ONLY after enabling
# Transformations on the Cloudflare zone (dashboard → Speed → Optimization →
# Image Resizing). When unset/false, <Image> ships the plain original instead of
# a /cdn-cgi/image srcset — because those URLs 404 until the zone toggle is on,
# and a failed srcset candidate renders broken (it does not fall back to src).
VITE_CF_IMAGE_RESIZING=false

# SEO: search-engine site-verification meta tags (US-291+). Paste the token from
# Google Search Console / Bing Webmaster Tools. Rendered into <head> at build;
# unset = the verification <meta> is simply omitted (no broken tag).
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=

# SEO / entity disambiguation (US-428). Brand social profiles for the
# twitter:site card and Organization.sameAs JSON-LD — the signals search +
# AI-answer engines use to resolve "GradeThread" in the Knowledge Graph. ONLY
# set a value once that profile is LIVE: a sameAs/twitter:site pointing at a
# 404 HURTS entity recognition (Google policy + the "only live URLs" rule).
# Each is emitted only when set, so leaving them blank is safe. The public
# GitHub org is always included automatically.
#   - VITE_TWITTER_SITE: the brand X @handle (with or without the leading @).
#   - VITE_TWITTER_CREATOR: distinct content-author handle; defaults to the site
#     handle when unset (publisher == creator on first-party pages).
#   - VITE_SOCIAL_*: full profile URLs (https://…) added to Organization.sameAs.
# Cloudflare Pages exposes these to BOTH the Vite build and the Functions SSR
# runtime, so the SPA, prerender, and blog/cert SSR all emit the same values.
VITE_TWITTER_SITE=
VITE_TWITTER_CREATOR=
VITE_SOCIAL_X=
VITE_SOCIAL_LINKEDIN=
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_CRUNCHBASE=

# US-430: AI training-crawler policy (Functions runtime). Unset = allow training
# bots (GPTBot/ClaudeBot/Google-Extended/Applebot-Extended) to crawl the public
# site. Set to "disallow"/"block"/"off"/"false"/"no"/"0" to emit Disallow blocks
# for them in /robots.txt — no code change. Citation/search bots are always
# allowed; aggressive scrapers are always blocked. See vault/40-growth/ai-crawler-policy.md.
AI_TRAINING_CRAWLERS=

# Optional Organization JSON-LD fields (US-428). Emitted only when set + valid,
# so we never assert an unmanned mailbox or a guessed date.
#   - VITE_CONTACT_EMAIL: public, monitored support address → contactPoint.
#   - VITE_FOUNDING_DATE: ISO 8601 (YYYY-MM-DD or YYYY) → foundingDate.
VITE_CONTACT_EMAIL=
VITE_FOUNDING_DATE=

# Deploy stamp: the commit SHA, surfaced to Sentry releases + the footer build
# tag. Cloudflare Pages exposes CF_PAGES_COMMIT_SHA at build — map it to this in
# the Pages build command (e.g. VITE_RELEASE_SHA=$CF_PAGES_COMMIT_SHA npm run build).
VITE_RELEASE_SHA=

# US-785: public launch date for the pre-launch banner. ISO 8601. The banner
# self-disables on/after this date (no deploy needed); unset = the hardcoded
# default in launch-banner.tsx. Set/correct this to change the date without a
# code change. Keep it AHEAD of the real launch (a past date hides the banner).
VITE_LAUNCH_DATE=

# US-716: reveal + wire the "Send to extension" listing-kit control for the
# GradeThread Lister browser extension (extension/). Both must be set for the
# control to appear: the flag turns it on, the ID is the unpacked/published
# Chrome extension id the SaaS posts the listing payload to (chrome.runtime
# externally_connectable). Leave unset to keep the control hidden.
VITE_LISTER_EXTENSION=
VITE_LISTER_EXTENSION_ID=

# US-2553: the public Chrome Web Store listing the buyer home links to.
# Optional — when unset it is derived from VITE_LISTER_EXTENSION_ID as
# https://chromewebstore.google.com/detail/<id>. Set it only to override that
# (a vanity URL, or a different store).
VITE_EXTENSION_WEBSTORE_URL=

# US-604: certificate_id of a real, public grade certificate to feature on the
# landing page. When set, the "See the product" section's CTA links to the LIVE
# certificate at /cert/<id> (the strongest conversion asset). Leave UNSET and the
# CTA falls back to signup — never a broken /cert link. Pick a flattering,
# representative grade you're happy to show every prospect.
VITE_SAMPLE_CERTIFICATE_ID=

# US-1901: Web push (browser notifications) — VAPID application-server PUBLIC key
# (base64url, uncompressed P-256 point). Optional: the Settings push toggle also
# fetches the key from the edge (GET /api/push/vapid-public-key), so this is just
# a build-time shortcut. MUST match the edge's VAPID_PUBLIC_KEY. Generate a
# keypair with `npx web-push generate-vapid-keys`. Leave unset → push falls back
# to the edge endpoint; email/in-app remain the delivery channels regardless.
VITE_VAPID_PUBLIC_KEY=
