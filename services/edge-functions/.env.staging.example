# ════════════════════════════════════════════════════════════════════
# STAGING env template (US-520). Start from .env.example — every variable
# documented there also applies here. This file lists ONLY the values that
# MUST DIFFER from production. Rule: staging shares NOTHING with prod — no
# DB, no buckets, no live-mode keys, no reused secrets.
# ════════════════════════════════════════════════════════════════════

# Staging runtime. Boot env-validation is warn-only (a missing feature group
# surfaces on /health/ready instead of crashing), security debug flags are
# honored, and /health reports env:"staging" for the smoke test.
EDGE_ENV=staging

# Staging Supabase stack — a SEPARATE self-hosted instance (or hosted project).
# NEVER the production api.gradethread.com URL or its service-role key.
SUPABASE_URL=https://api-staging.gradethread.com
SUPABASE_SERVICE_ROLE_KEY=staging-service-role-key

# Stripe TEST MODE only (sk_test_…). Register a separate webhook endpoint at
#   https://functions-staging.gradethread.com/api/webhooks/stripe
# in the Stripe TEST-mode dashboard and use ITS signing secret here. Create the
# test-mode products/prices with: node scripts/setup-stripe-pricing.mjs
STRIPE_SECRET_KEY=sk_test_…
STRIPE_WEBHOOK_SECRET=whsec_…
# All STRIPE_PRICE_* ids must be TEST-mode prices (live ids won't resolve).

# eBay SANDBOX with the sandbox keyset + staging callback.
EBAY_ENV=sandbox
EBAY_REDIRECT_URI=https://functions-staging.gradethread.com/api/flipdesk/ebay/oauth/callback

# Anthropic: a SEPARATE key on a low monthly budget cap, so a staging loop
# can't burn the production AI budget.
ANTHROPIC_API_KEY=staging-anthropic-key

# Fresh secrets — generate new values (openssl rand …) for staging; never copy
# prod's. A leaked staging secret must not open anything in production.
FLIPDESK_INTERNAL_JOB_SECRET=
EDGE_ENCRYPTION_KEY=
CERT_SIGNING_KEY=
API_KEY_PEPPER=
CONTENT_INTERNAL_JOB_SECRET=
CF_ORIGIN_SECRET=
CF_PAGES_ORIGIN_SECRET=

# Mail: point at a catch-all/test mailbox (e.g. SES sandbox or Mailpit) so
# staging flows never email real users.
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=staging@gradethread.com

# Public URLs of the staging surfaces.
PUBLIC_SITE_URL=https://staging.gradethread.com
COOLIFY_FQDN=https://functions-staging.gradethread.com

# Apple IAP receipt validation against the sandbox environment.
APPSTORE_ENVIRONMENT=Sandbox

# Observability: separate Sentry environment (or DSN) and a separate PostHog
# project, so staging noise never pollutes production dashboards.
SENTRY_DSN=
POSTHOG_KEY=

# Leave UNSET in staging (prod-only integrations): INDEXNOW_KEY (would ping
# search engines), CLOUDFLARE_API_TOKEN/CLOUDFLARE_ZONE_ID (would purge the
# prod blog cache), R2_* unless a staging bucket exists.
