# ════════════════════════════════════════════════════════════════════
# Boot-time env validation (US-777). The edge service validates env on start:
#   REQUIRED (always)     — SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY,
#                           ANTHROPIC_API_KEY (or CLAUDE_API_KEY)
#   REQUIRED (production)  — + STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET,
#                           FLIPDESK_INTERNAL_JOB_SECRET, EDGE_ENCRYPTION_KEY,
#                           CERT_SIGNING_KEY, API_KEY_PEPPER
#     → missing one in production CRASHES boot (loud, not latent).
#   FEATURE GROUPS        — stripe_prices, ebay, smtp, google_photos,
#                           observability(SENTRY_DSN). A missing group only warns
#                           at boot + shows on /health/ready `features`; it never
#                           blocks startup. Dev/test are permissive (warn-only).
#   See lib/env-validation.ts.
# ════════════════════════════════════════════════════════════════════

# Supabase (service role - server-side only)
SUPABASE_URL=https://api.gradethread.com
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Connection pooling for DIRECT-PG ops scripts (US-570) ──────────
# The edge service itself reaches Supabase over HTTP (SUPABASE_URL → Kong →
# PostgREST) and opens NO raw Postgres sockets, so it needs neither of these.
# They are only for the direct-PG ops scripts (backups, migrations). See
# CONNECTION_POOLING.md for the topology + pool sizing.
#   POOL_URL    → Supavisor transaction pooler (port 6543): pooled app/job
#                 workload. Many clients share a small backend pool, so edge
#                 replicas (US-501) can't exhaust Postgres max_connections.
#   DIRECT_URL  → direct Postgres (port 5432): pg_dump/pg_restore/migrations/DDL
#                 ONLY — transaction pooling breaks session-scoped work. The
#                 backup cron (scripts/ops/backup-postgres.sh) MUST use this.
SUPABASE_DB_POOL_URL=postgres://postgres:your-db-password@db-host:6543/postgres
SUPABASE_DB_DIRECT_URL=postgres://postgres:your-db-password@db-host:5432/postgres

# ─── AI configuration ───────────────────────────────────────────────
# These vars are designed to be set as Coolify "Team Shared Variables"
# so every Pearson Media project changes together. Read by
# services/edge-functions/src/lib/ai-config.ts.
#
# API key — set either name; ANTHROPIC_API_KEY wins if both are set.
ANTHROPIC_API_KEY=your-anthropic-api-key
CLAUDE_API_KEY=

# Model routing. DEFAULT_AI_MODEL handles vision + composite work;
# LIGHTWEIGHT_AI_MODEL handles text-only enrichment/listing copy.
DEFAULT_AI_MODEL=claude-sonnet-4-6
LIGHTWEIGHT_AI_MODEL=claude-haiku-4-5-20251001
# Optional — override the model for the grading composite step (text-only
# synthesis of per-image vision results). Defaults to DEFAULT_AI_MODEL.
# Set to a cheaper model to cut cost if synthesis quality holds up.
GRADING_COMPOSITE_MODEL=

# Behavior toggles (all optional — defaults shown).
AI_TIMEOUT_MS=120000
AI_MAX_RETRIES=2
# AI_TEMPERATURE applies to the NON-grading flows (enrichment, listing copy,
# content). Leaving it unset lets the SDK default apply there. It does NOT
# affect grading.
AI_TEMPERATURE=
# US-481: grading (per-image vision + composite) is ALWAYS low-temperature for
# reproducibility — the same garment must not re-score differently on a dispute.
# It defaults to 0 (greedy decoding) regardless of AI_TEMPERATURE. Only raise
# this if a documented experiment shows a higher value improves accuracy without
# hurting self-consistency; it is clamped to [0, 0.2].
GRADING_AI_TEMPERATURE=
AI_ENABLE_CACHING=true

# US-573: grading-pipeline memory capacity (see CAPACITY.md). The grading
# pipeline buffers every submission's photos as base64 data URIs in-process;
# GRADING_MAX_CONCURRENT_PIPELINES caps how many submissions do so at once (the
# OOM bound). EDGE_MEMORY_LIMIT_MB is the container memory limit the app reports
# against on /health/metrics — keep it in sync with the compose
# deploy.resources.limits.memory (2G → 2048).
GRADING_MAX_CONCURRENT_PIPELINES=6
EDGE_MEMORY_LIMIT_MB=2048

# Optional — provider selection + alternative provider keys. GradeThread's
# edge service currently always uses Anthropic, but these are reserved so
# the same Coolify Team Shared block covers every project.
AI_DEFAULT_PROVIDER=anthropic
OPENAI_GLOBAL_API=
GOOGLE_GLOBAL_API=

# ─── Stripe (server-side) ─────────────────────────────────────────
# Core auth — get both from Stripe Dashboard → Developers.
# Webhook endpoint registered at: https://functions.gradethread.com/api/webhooks/stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Price IDs — set per environment. Run `stripe products list` to see them,
# or `stripe prices list --product prod_…` to get a product's prices.

# FlipDesk subscriptions (recurring, USD).
#   Starter  — $29/mo, $290/yr
#   Pro      — $59/mo, $590/yr
#   Business — $99/mo, $990/yr
STRIPE_PRICE_FLIPDESK_STARTER_MONTHLY=price_…
STRIPE_PRICE_FLIPDESK_STARTER_YEARLY=price_…
STRIPE_PRICE_FLIPDESK_PRO_MONTHLY=price_…
STRIPE_PRICE_FLIPDESK_PRO_YEARLY=price_…
STRIPE_PRICE_FLIPDESK_BUSINESS_MONTHLY=price_…
STRIPE_PRICE_FLIPDESK_BUSINESS_YEARLY=price_…

# Buyer subscription plans (US-1799). Created by scripts/setup-stripe-pricing.mjs
# (BUYER catalog). Guard $8/mo $80/yr · Connoisseur $19/mo $190/yr. The edge
# reads these unprefixed; the frontend/CF-Pages reads the VITE_-prefixed aliases.
STRIPE_PRICE_BUYER_GUARD_MONTHLY=price_…
STRIPE_PRICE_BUYER_GUARD_YEARLY=price_…
STRIPE_PRICE_BUYER_CONNOISSEUR_MONTHLY=price_…
STRIPE_PRICE_BUYER_CONNOISSEUR_YEARLY=price_…

# GradeThread per-grade tiers (one-time, USD).
#   Standard — $2.99 (48h SLA, 1 credit)
#   Premium  — $7.99 (12h SLA, 3 credits)
#   Express  — $12.99 (1h SLA,  5 credits)
STRIPE_PRICE_GRADE_STANDARD=price_…
STRIPE_PRICE_GRADE_PREMIUM=price_…
STRIPE_PRICE_GRADE_EXPRESS=price_…

# Credit packs (one-time, USD). Products carry metadata.credits which the
# webhook in routes/webhooks.ts reads to grant credits server-side.
#   10 credits  — $24.99
#   25 credits  — $59.99
#   50 credits  — $109.99
#   100 credits — $199.99
STRIPE_PRICE_CREDITS_10=price_…
STRIPE_PRICE_CREDITS_25=price_…
STRIPE_PRICE_CREDITS_50=price_…
STRIPE_PRICE_CREDITS_100=price_…

# B2B API overage credit packs (US-1792, one-time). Created by
# scripts/setup-stripe-pricing.mjs (API_OVERAGE catalog). $10/$50/$100/$200.
STRIPE_PRICE_API_OVERAGE_10=price_…
STRIPE_PRICE_API_OVERAGE_50=price_…
STRIPE_PRICE_API_OVERAGE_100=price_…
STRIPE_PRICE_API_OVERAGE_200=price_…

# Email (transactional notifications) via SMTP — e.g. Amazon SES.
# Same variable names Supabase uses for its SMTP, so the edge service and
# Supabase Auth can share one mail setup. Read by src/lib/email.ts.
#   SES SMTP host example: email-smtp.us-east-1.amazonaws.com
#   Port 587 (STARTTLS) or 465 (implicit TLS). SMTP_USER/SMTP_PASS are SES
#   SMTP credentials (NOT your AWS access keys). SMTP_ADMIN_EMAIL must be a
#   verified SES sender/domain.
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=your-ses-smtp-username
SMTP_PASS=your-ses-smtp-password
SMTP_ADMIN_EMAIL=notifications@gradethread.com
SMTP_SENDER_NAME=GradeThread

# GoTrue "Send Email" auth hook shared secret. When the prod GoTrue container is
# configured with GOTRUE_HOOK_SEND_EMAIL_ENABLED=true +
# GOTRUE_HOOK_SEND_EMAIL_URI=https://functions.gradethread.com/api/auth/hooks/send-email,
# it POSTs every auth email (signup-confirm, password reset, magic-link,
# email-change) here instead of sending over its own SMTP. This lets us render
# them through the branded template and ship them over the SAME pipeline as the
# grade emails, each carrying a 6-digit OTP + a confirm link that lands on the
# frontend (not api.gradethread.com). This var MUST equal
# GOTRUE_HOOK_SEND_EMAIL_SECRETS (Standard Webhooks format, e.g.
# `v1,whsec_<base64>`; pipe-separate two during rotation). Unset → the hook
# route rejects all calls (500), so set both together or leave the hook disabled.
AUTH_EMAIL_HOOK_SECRET=v1,whsec_your-base64-secret

# SES deliverability (US-1057): bounce/complaint suppression.
#   1. In SES, verify the sending DOMAIN (not just the address) and enable Easy
#      DKIM — publish the 3 CNAME records SES gives you so DKIM aligns.
#   2. SPF: publish "v=spf1 include:amazonses.com ~all" (or add the include to an
#      existing record) so the envelope-from aligns.
#   3. DMARC: publish a _dmarc TXT record (start "v=DMARC1; p=none; rua=…",
#      tighten to quarantine/reject once DKIM+SPF pass). DKIM or SPF alignment
#      with the From domain is required for DMARC to pass.
#   4. Create an SES "Configuration Set" with an SNS destination for Bounce +
#      Complaint events; point the SNS topic's HTTPS subscription at
#      https://functions.gradethread.com/api/webhooks/ses (the route confirms the
#      SNS subscription automatically and writes hard bounces/complaints to the
#      email_suppressions table, which email.ts checks before every send).
# Optional: restrict the feedback route to one SNS topic (forgery defense).
SES_SNS_TOPIC_ARN=

# ─── FlipDesk: eBay integration ─────────────────────────────────────
# Sandbox or production. Production requires eBay Developer Program approval.
EBAY_ENV=sandbox
EBAY_APP_ID=your-ebay-app-id
EBAY_CERT_ID=your-ebay-cert-id
EBAY_DEV_ID=your-ebay-dev-id
EBAY_REDIRECT_URI=https://functions.gradethread.com/api/flipdesk/ebay/oauth/callback
# eBay "RuName" — the registered redirect name (NOT the URL). Required by the
# OAuth authorize endpoint. Find under Developer Account → User Tokens.
EBAY_RU_NAME=
# OAuth scopes requested at /oauth/start. Space-separated. Default covers the
# Sell Inventory + Marketing + Account APIs needed to publish a listing.
EBAY_SCOPES=https://api.ebay.com/oauth/api_scope https://api.ebay.com/oauth/api_scope/sell.inventory https://api.ebay.com/oauth/api_scope/sell.marketing https://api.ebay.com/oauth/api_scope/sell.account https://api.ebay.com/oauth/api_scope/sell.fulfillment https://api.ebay.com/oauth/api_scope/sell.finances
# Default marketplace + category tree for Taxonomy lookups.
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_CATEGORY_TREE_ID=0
# US-542: set to "true" ONLY if your eBay keyset has been granted the
# buy.marketplace.insights scope. When enabled, AutoLister prices from eBay's
# realized (LAST_SOLD) comps instead of active asking prices. Left unset/false,
# pricing falls back to the seller's own sales table (private comps), then to
# active Browse comps (flagged as estimated). Requires eBay approval.
EBAY_MARKETPLACE_INSIGHTS=false
# US-1474: bulk order sync via the Sell Feed API (LMS_ORDER_REPORT) for
# high-volume sellers instead of paging /sell/fulfillment/v1/order. OFF by
# default; when "on"/"true"/"1" AND a seller's catalog is at/above
# EBAY_FEED_SYNC_MIN_CATALOG (default 1000), the orders pass runs a report task
# (create → poll → gunzip → parse) and falls back to paging on any failure.
# ⚠️ Validate against a real high-volume account before enabling — the
# OrderReport keys line items by Trading TransactionID (not the Sell lineItemId
# the paged path uses), so switching a seller between paths can re-key/duplicate
# recent sales. The active-inventory report is intentionally NOT used (it is
# price/quantity only and cannot reconstruct offers).
EBAY_FEED_SYNC=off
EBAY_FEED_SYNC_MIN_CATALOG=1000
# Shared secret eBay sends with notification deliveries
EBAY_VERIFICATION_TOKEN=
# US-364: optional OAuth token-revocation endpoint. When set, disconnect and
# account-deletion POST the user's refresh token here (RFC-7009 style) to revoke
# the grant upstream so a long-lived refresh token isn't left valid at eBay after
# the connection is removed. Leave UNSET on keysets that don't expose revocation —
# the flow then deactivates + nulls the stored tokens locally and skips the call.
EBAY_TOKEN_REVOKE_URL=
# Sandbox-only: when "true", the /webhooks/ebay receiver LOGS raw payload +
# headers and SKIPS HMAC verification. Use this to confirm eBay's exact
# signature scheme matches expectations the first time you wire up a
# notification subscription. Automatically IGNORED when EDGE_ENV=production
# (lib/env.ts) — it can never bypass verification or leak payloads in prod.
WEBHOOK_PAYOUT_DEBUG=
# Deploy environment. Defaults to "production" (fail-closed) when unset.
# Set to "development" only for local sandbox work.
EDGE_ENV=production
# US-578: trace/log sampling rate in [0,1] — bounds logging cost (the edge
# analogue of the frontend Sentry tracesSampleRate: 0.1). Samples ONLY
# successful (2xx/3xx) access lines + ok-outcome latency spans; every 4xx/5xx
# and all business counters are always logged. Unset/blank or invalid => 1.0
# (log everything). See OBSERVABILITY.md.
EDGE_TRACE_SAMPLE_RATE=0.1
# Token used by FlipDesk to authenticate scheduled jobs (cron → POST endpoints).
# Also guards the grading regression monitor cron (US-327):
#   POST /api/jobs/grading-monitor  with header  X-Internal-Job-Secret: <this>
FLIPDESK_INTERNAL_JOB_SECRET=
# US-795: days a signed-out / dead (APNs-rejected) push token stays before the
# push-token-prune cron deletes it. Default 90.
# PUSH_TOKEN_PRUNE_DAYS=90

# ─── FlipDesk: Google Photos import (Photos Picker API) ─────────────
# Lets AutoLister import photos the user picks from Google Photos. Uses the
# Photos PICKER API (the broad Library API was retired 2025-03-31).
# Setup in Google Cloud Console:
#   1. Enable the "Photos Picker API" on the project.
#   2. OAuth consent screen → add scope
#        https://www.googleapis.com/auth/photospicker.mediaitems.readonly
#      (a "sensitive" scope → needs verification before >100 external users;
#       works immediately for test users while the app is in "testing").
#   3. Create (or REUSE) a Web OAuth client and add this authorized redirect URI:
#        https://functions.gradethread.com/api/flipdesk/google/photos/oauth/callback
# You can reuse the SAME OAuth client as your Supabase "Continue with Google"
# sign-in (one client can serve multiple scopes + redirect URIs). The GSC
# integration uses a SERVICE ACCOUNT and is NOT reusable here (service accounts
# can't access a consumer's personal Google Photos). Unset = feature returns 503.
# Shared Google OAuth client — reuse ONE client across every Google integration
# (it can serve multiple scopes + redirect URIs), so you don't duplicate the
# same id/secret per service. Photos import reads these by default.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional per-service OVERRIDE — only set these if Google Photos should use a
# DIFFERENT OAuth client than the shared one above.
# GOOGLE_PHOTOS_CLIENT_ID=
# GOOGLE_PHOTOS_CLIENT_SECRET=
# Optional — defaults to the functions.gradethread.com callback above.
# GOOGLE_PHOTOS_REDIRECT_URI=
# US-146 Google Sheets sync. Reuses GOOGLE_CLIENT_ID/SECRET above by default
# (just enable the Sheets + Drive APIs and add the callback below to the OAuth
# client). Requested scopes: drive.file + spreadsheets. Unset = sync returns 503.
# Optional per-service OVERRIDE — only if Sheets should use a different client.
# GOOGLE_SHEETS_CLIENT_ID=
# GOOGLE_SHEETS_CLIENT_SECRET=
# Optional — defaults to functions.gradethread.com/api/flipdesk/google/oauth/callback.
# GOOGLE_SHEETS_REDIRECT_URI=

# ─── Grading self-improvement: eval gate + regression monitor ───────
# Activation gate thresholds (US-070/00050). A new prompt version can't go
# live until it clears BOTH against the golden set. These are also published
# on the public /transparency page (US-326).
EVAL_MAX_MAE=1.0
EVAL_MIN_AGREEMENT=0.7
# Confidence below which a grade is routed to human review (US-331). Default
# 0.75. Use the Confidence Calibration panel's recommended value to tune it.
# GRADING_REVIEW_CONFIDENCE_THRESHOLD=0.75
# Mandatory grade review: confidence at/above which a CLEAN grade (not routed to
# human review, not flagged) auto-finalizes and goes live WITHOUT super-admin
# review. A number in (0,1]; default 0.9. Set "off" for fully-manual review
# (every grade waits for a super-admin). Lower it to clear more of the queue.
# GRADE_AUTO_APPROVE_CONFIDENCE=0.9
# Photo-reuse Hamming threshold in bits (US-337). Default 10.
# GRADING_REUSE_MAX_HAMMING=10
# Grading regression monitor (US-327). Schedule an external cron to hit
# POST /api/jobs/grading-monitor daily. Alerts go to MONITOR_ALERT_EMAIL, or
# SMTP_ADMIN_EMAIL if unset. All thresholds below are optional (defaults shown).
MONITOR_ALERT_EMAIL=
# Where "new grade dispute filed" alerts go. Falls back to SMTP_ADMIN_EMAIL.
DISPUTE_ALERT_EMAIL=
# AI cost budget guardrails (US-895). Schedule POST /api/jobs/ai-budget-guardrails
# (e.g. every 15min). Breach alerts go to AI_BUDGET_ALERT_EMAIL, else
# MONITOR_ALERT_EMAIL, else SMTP_ADMIN_EMAIL; webhook to AI_BUDGET_ALERT_WEBHOOK,
# else MONITOR_ALERT_WEBHOOK. All optional — budgets are managed at /admin/ai-spend.
# AI_BUDGET_ALERT_EMAIL=
# AI_BUDGET_ALERT_WEBHOOK=
# MONITOR_RUN_EVAL=true            # set false to skip the (costlier) live golden-set eval
# MONITOR_MIN_SAMPLE=10            # min reviewed/sold items before a rate can alert
# MONITOR_MIN_AGREEMENT=0.7        # defaults to EVAL_MIN_AGREEMENT
# MONITOR_MAX_MISREAD=0.1          # intentional-design misread rate ceiling
# MONITOR_MAX_DISPUTE=0.05         # buyer dispute rate ceiling
# MONITOR_EVAL_MAE_REGRESSION_DELTA=0.3
# MONITOR_EVAL_AGREEMENT_REGRESSION_DELTA=0.1
# MONITOR_COOLDOWN_HOURS=12        # don't re-email an identical alert set within this window

# Base64-encoded 32-byte AES-256 key used to encrypt stored OAuth tokens in
# marketplace_connections. Generate with:
#   openssl rand -base64 32
# Store ONLY in the secrets manager — never commit. Ciphertexts are bound to the
# owning user_id via AES-GCM AAD (US-352).
EDGE_ENCRYPTION_KEY=
# Short label recorded in each ciphertext so the key can be rotated. Default k1.
# EDGE_ENCRYPTION_KEY_ID=k1
# Rotation window only: comma-separated `id:base64key` pairs of RETIRED keys kept
# to decrypt not-yet-re-encrypted rows. Remove an id once no row still uses it.
# See lib/crypto-aes.ts "Key rotation procedure".
# EDGE_ENCRYPTION_KEYS_OLD=k1:OLDBASE64KEY==

# US-356: OPTIONAL server-side pepper for hashing public API keys. When set,
# stored key hashes are HMAC-SHA256(pepper, key) instead of plain SHA-256, so a
# leaked api_keys table can't be brute-forced without the pepper. NOTE: setting
# or changing this invalidates all existing keys (they must be re-issued), so
# configure it BEFORE issuing production keys.
# API_KEY_PEPPER=

# US-333: secret used to HMAC-sign the tamper-evident certificate content hash.
# OPTIONAL — when unset, certificates use hash-only integrity (still detects a
# tampered DB row / forged screenshot via the public /cert/:id/verify endpoint);
# when set, only the server can mint a valid signature, so a tamperer can't
# recompute a matching one. Use a long random secret, e.g.:
#   openssl rand -hex 32
CERT_SIGNING_KEY=

# ─── FlipDesk: image pipeline + cold storage ────────────────────────
# Cloudflare R2 for archived photos (>30 days completed)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=gradethread-archive
R2_PUBLIC_BASE_URL=https://cdn.gradethread.com

# remove.bg API for background-removed product photos (creates flatlay
# variants). Sign up at remove.bg/api — free tier covers 50 calls/month.
REMOVE_BG_API_KEY=

# ─── FlipDesk: GradeThread bridge ───────────────────────────────────
# When FlipDesk runs as a separate front-end, it uses a GradeThread API key.
# Inside this consolidated service, prefer the service-role Supabase client.
GRADETHREAD_API_KEY=

# ─── Content module: Blog & Social ──────────────────────────────────
# OpenAI key for gpt-image-1 hero generation. Only the image API is used.
OPENAI_API_KEY=
# HMAC signing secret for outbound publish webhooks (X-Content-Signature).
# Generate with: openssl rand -hex 32
CONTENT_WEBHOOK_SIGNING_SECRET=
# Shared secret for the autonomous scheduler endpoint (Make.com cron).
# Generate with: openssl rand -hex 32
# Rotation (US-487): set the NEW value here, move the previous one to
# CONTENT_INTERNAL_JOB_SECRET_OLD, update the Make.com scenario, then clear
# _OLD. Callers may also send a signed timestamped request instead of the raw
# secret (X-Internal-Job-Timestamp + X-Internal-Job-Signature =
# hex HMAC-SHA256(secret, "v1:<ts>:<METHOD>:<path>"); 5-min window, replays
# rejected) — preferred, since the secret never crosses the wire.
CONTENT_INTERNAL_JOB_SECRET=
CONTENT_INTERNAL_JOB_SECRET_OLD=
# US-943: shared secret for the autonomous trial-drip orchestration tick
# (POST /api/drip/tick, Make.com/Coolify cron). Same auth shape as the content
# scheduler: present it as X-Internal-Job-Secret, or send a signed timestamped
# request (preferred), or fall back to an admin JWT for the dashboard "Run now".
# Generate with: openssl rand -hex 32. Rotation: set the NEW value here, move the
# previous one to DRIP_INTERNAL_JOB_SECRET_OLD, update the cron, then clear _OLD.
DRIP_INTERNAL_JOB_SECRET=
DRIP_INTERNAL_JOB_SECRET_OLD=
# US-923: the ONE external touchpoint that kicks off the autonomous newsletter run
# (POST /api/newsletter/scheduler/tick, Make.com/Coolify cron). Same auth shape as
# the content scheduler: present it as X-Internal-Job-Secret, or send a signed
# timestamped request (preferred), or fall back to an admin JWT for "Run now".
# Generate with: openssl rand -hex 32. Rotation: set the NEW value here, move the
# previous one to NEWSLETTER_INTERNAL_JOB_SECRET_OLD, update the cron, then clear _OLD.
NEWSLETTER_INTERNAL_JOB_SECRET=
NEWSLETTER_INTERNAL_JOB_SECRET_OLD=
# US-923: HMAC signing secret for outbound newsletter lifecycle webhooks
# (X-Newsletter-Signature on issue.created / issue.sent notifications to the
# configurable newsletter_make_webhook_url). Generate with: openssl rand -hex 32.
NEWSLETTER_WEBHOOK_SIGNING_SECRET=
# Ops alert URL (Slack incoming webhook / PagerDuty-compatible) pinged when a
# content webhook delivery exhausts all retries (US-487). Falls back to
# MONITOR_ALERT_WEBHOOK when unset.
CONTENT_ALERT_WEBHOOK=
# US-977: slug of the content_authors row the autonomous scheduler bylines
# generated blog posts to (E-E-A-T Person author + /authors profile page).
# Defaults to the seeded house author 'gradethread-team' when unset; point it at
# a named, credentialed author slug to attribute generated posts to that person.
CONTENT_DEFAULT_AUTHOR_SLUG=gradethread-team
# Cloudflare API token + zone ID for purging /blog/* after publish.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# Public site root used when building canonical URLs + CTAs.
PUBLIC_SITE_URL=https://gradethread.com

# ─── SEO: IndexNow instant indexing (US-296) ────────────────────────
# Key for IndexNow (Bing/Yandex/Naver/Seznam). 32–128 hex chars. The matching
# key file MUST be hosted at https://gradethread.com/<INDEXNOW_KEY>.txt
# (committed as public/<key>.txt). When unset, submissions cleanly no-op.
# Generate with: openssl rand -hex 16
INDEXNOW_KEY=

# ─── Analytics: server-side PostHog capture (US-216 / US-219) ───────
# Lifecycle events that only happen server-side (subscription.ended from the
# Stripe webhook; trial.converted / trial.expiring_3d / trial.expired_to_free
# from the trial-check cron) are sent via lib/posthog.ts. Use the same PostHog
# project API key the SPA uses (VITE_POSTHOG_KEY). When unset, capture no-ops.
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# ─── Observability: Sentry-compatible error tracking (US-491) ───────
# DSN for the exception tracker. When set, captureException ships errors to
# Sentry (tagged with the release SHA); when unset, errors are local structured
# logs only. /health and /health/ready report errorTracking enabled/disabled.
# Validated as the `observability` feature group (US-777) — missing only warns.
SENTRY_DSN=

# ─── Rate limiting: Cloudflare origin trust (US-354 / US-781) ────────
# CF_ORIGIN_SECRET (US-354): a Cloudflare Transform Rule injects
# `cf-origin-secret: <this>` on every proxied request. When set, the limiter only
# trusts a CF-Connecting-IP that also carries the matching header — a direct-to-
# origin request can't spoof an IP. Unset = trust the network layer. openssl rand -hex 32
CF_ORIGIN_SECRET=
# CF_PAGES_ORIGIN_SECRET (US-781): the public-content limiter
# (/api/content/public/* — the one unauthenticated mount, 60/min/IP, fail-closed)
# bypasses requests carrying `x-pages-origin: <this>`, so the blog/cert SSR Pages
# Functions — which proxy those endpoints for ALL visitors through one Pages IP —
# aren't starved. Set the SAME value as a Cloudflare Pages env var so the SSR
# workers send it (functions/_shared/blog-render.ts). openssl rand -hex 32
CF_PAGES_ORIGIN_SECRET=

# Server
PORT=8787

# Schema-version boot guard (US-778) grace window. On a behind-version DB in
# production, the edge re-polls the migrations table this many times (sleeping
# _DELAY_MS between) before refusing to start — so a deploy that lands its
# migration a few seconds late delays the boot instead of crash-looping the
# whole service. Defaults ≈ 40s (8 × 5000ms). Set _ATTEMPTS=0 to disable.
# The durable fix is to apply migrations BEFORE the edge rolls (COOLIFY.md →
# "Apply migrations BEFORE the edge rolls"); this is the residual-race safety net.
SCHEMA_GUARD_GRACE_ATTEMPTS=8
SCHEMA_GUARD_GRACE_DELAY_MS=5000

# ─── Coolify ────────────────────────────────────────────────────────
# Set the FQDN Traefik should bind. Defaults to functions.gradethread.com.
# (api.gradethread.com is Supabase Kong on a separate container — do not reuse.)
COOLIFY_FQDN=https://functions.gradethread.com

# ─── App Store / StoreKit IAP (US-788) ──────────────────────────────
# Validated as the `appstore` feature group (US-777): unset → IAP receipt
# verification + the App Store Server Notifications V2 webhook can't validate
# Apple's JWS; surfaced on /health/ready, never crashes boot.
#
# The group is IAP-GATED: when IAP isn't in use (IAP_ENABLED falsey AND none of
# the vars below set) the group reports `disabled` on /health/ready and the boot
# log stays quiet about it. Set IAP_ENABLED=1 (or any APPLE_*/APPSTORE_ var) to
# turn it on; a half-configured deploy then gets a loud "[BOOT] feature 'appstore'
# is not fully configured" warning — the launch-blocker US-788 guards against.
#   IAP_ENABLED         — 1|true|yes|on to force the appstore group on even before
#                         the vars are filled in (otherwise auto-on when any are set)
#   APPLE_APP_APPLE_ID  — the numeric App Apple ID (App Store Connect → App →
#                         App Information). Required for STRICT Production JWS
#                         validation; the verifier warns at init if unset in prod.
#   APPLE_BUNDLE_ID     — e.g. com.gradethread.app
#   APPLE_ROOT_CA_G3_B64 — base64 of Apple's AppleRootCA-G3 cert (JWS chain root)
#   APPSTORE_ENVIRONMENT — Sandbox | Production (use Sandbox on staging)
IAP_ENABLED=
APPLE_APP_APPLE_ID=
APPLE_BUNDLE_ID=
APPLE_ROOT_CA_G3_B64=
APPSTORE_ENVIRONMENT=Sandbox

# ── Google Ads API (§2j) — keyword research (US-1072) + Ads Command Center
#    (US-1696+, GAQL via google-ads-client.ts). All optional: unset → the Ads
#    features no-op cleanly (never throws at boot). Customer ids are digits-only.
#   GOOGLE_ADS_DEVELOPER_TOKEN   — approved Google Ads API developer token (MCC)
#   GOOGLE_ADS_CLIENT_ID         — OAuth 2.0 client id (Google Cloud Console)
#   GOOGLE_ADS_CLIENT_SECRET     — OAuth 2.0 client secret
#   GOOGLE_ADS_REFRESH_TOKEN     — long-lived refresh token (offline access)
#   GOOGLE_ADS_LOGIN_CUSTOMER_ID — manager (MCC) id, sent as login-customer-id
#   GOOGLE_ADS_CUSTOMER_ID       — the Ads account operated on
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_ID=

# ── Apple Search Ads (US-1707) — iOS acquisition into the shared ads_* tables.
#    All optional: unset → the ASA sync/analysis no-op (never throws at boot).
#    Auth = OAuth2 client-credentials with an ES256 JWT client-secret (a .p8 key).
#   APPLE_SEARCH_ADS_ORG_ID      — your ASA org id (X-AP-Context: orgId=…)
#   APPLE_SEARCH_ADS_KEY_ID      — the key id (kid) of the .p8 private key
#   APPLE_SEARCH_ADS_CLIENT_ID   — the API client id (JWT sub)
#   APPLE_SEARCH_ADS_TEAM_ID     — the team id (JWT iss); defaults to CLIENT_ID
#   APPLE_SEARCH_ADS_PRIVATE_KEY — the .p8 private key PEM (literal or \n-escaped)
APPLE_SEARCH_ADS_ORG_ID=
APPLE_SEARCH_ADS_KEY_ID=
APPLE_SEARCH_ADS_CLIENT_ID=
APPLE_SEARCH_ADS_TEAM_ID=
APPLE_SEARCH_ADS_PRIVATE_KEY=
