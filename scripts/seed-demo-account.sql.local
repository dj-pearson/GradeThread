INSERT INTO public.submissions (id, user_id, garment_type, garment_category, brand, title, description, status, payment_status, created_at) VALUES
('7ee5c530-c957-5b87-9a1e-fc33bf4ff0ec', 'd54d2cc8-aa82-4a95-ad3b-e899d7a83454', 'bottoms', 'pants', 'Vuori', 'Vuori Women''s Jogger Sweatpants Size M Gray Recycled Polyester Drawstring', 'Vuori jogger-style sweatpants in a heathered gray colorway. Made from 89% recycled polyester and 11% elastane for a soft, stretchy feel. Features an elasticized waistband with a woven drawstring and ribbed ankle cuffs. Size M. Manufactured in Vietnam. Item appears in good used condition with no visible damage, staining, or heavy wear noted in the photos.', 'completed', 'included', '2026-06-26 02:43:14.75757+00'),
('d5acf3a3-c4d0-56f2-9067-d3b2ac6b0691', 'd54d2cc8-aa82-4a95-ad3b-e899d7a83454', 'bottoms', 'shorts', 'Lululemon', 'Lululemon Men''s Khaki Chino Shorts Size 33', 'Lululemon men''s performance chino shorts in khaki/tan. Size 33 waist. Features a smooth, lightweight synthetic performance fabric, flat-front styling, button-and-zip fly closure, two front slash pockets, two back welt pockets, and belt loops. Great for golf, travel, or everyday wear.

Condition: Good used condition. No visible stains or tears. Minor surface scuffing on the metal button. Ready to wear.', 'completed', 'included', '2026-06-25 21:41:43.106577+00'),
('4a2fdcc3-0026-596e-b824-f4e8b6949339', 'd54d2cc8-aa82-4a95-ad3b-e899d7a83454', 'tops', 'sweater', 'Magashoni', 'Magashoni 100% Cashmere Wrap Belted Cardigan Sweater – Dark Brown', 'Luxurious 100% cashmere wrap-style cardigan sweater in a rich dark brown. Features a self-tie belt, long sleeves with ribbed cuffs, and a ribbed hem. The open-front wrap silhouette gives it a relaxed, elegant drape. Care label reads RN 86804 / CA 30427 — 100% Cashmere; hand wash in cold water with mild detergent, towel dry, reshape and lay flat; iron on mild heat or dry clean. Condition: pre-owned with light general wear; some lint/pilling visible on the surface consistent with cashmere use. No major damage noted.', 'completed', 'included', '2026-06-26 00:34:22.451132+00');

-- 4) Grade reports (certificates). Integrity fields nulled (mirror); cert_number nulled to avoid UNIQUE clash.
INSERT INTO public.grade_reports (id, submission_id, overall_score, grade_tier, fabric_condition_score, structural_integrity_score, cosmetic_appearance_score, functional_elements_score, odor_cleanliness_score, ai_summary, detailed_notes, confidence_score, model_version, certificate_id, created_at, needs_human_review, human_reviewed, defects_found, detected_style_attributes, buyer_writeup) VALUES
('dc317246-14a3-56ce-a1e0-c5099575ec6c', '7ee5c530-c957-5b87-9a1e-fc33bf4ff0ec', '8.5', 'Excellent', '8.5', '8.5', '8.0', '8.5', '7.0', 'These Vuori women''s jogger sweatpants in a heathered sage/teal-green colorway present in excellent used condition across all assessed images. Fabric surface is clean, free of pilling, staining, abrasion, or fading, and seams are intact throughout. Functional elements including the elastic waistband, drawstring with metal aglets, side slash pockets, and ribbed ankle cuffs all appear fully operational and undamaged. The only noted issues are ordinary reversible wrinkles from storage and folding, which carry no meaningful impact on condition grade. Odor and cleanliness could not be assessed from imagery and are held at a neutral baseline.', '{"back":"Issues: [minor] General wrinkles and creasing across the back panel from folding/laying flat (entire back panel, concentrated in crotch and thigh area). Signals: [positive] Fabric surface appears clean with no visible stains or soiling; [positive] No visible pilling on the fabric surface; [positive] Seams appear intact and well-constructed throughout; [positive] Elastic waistband retains its gathered shape with no signs of stretching out; [positive] Ribbed ankle cuffs appear intact and undamaged; [positive] Color is consistent across the entire garment with no fading or discoloration; [neutral] Ordinary wrinkles present from storage/laying flat, easily resolved with washing or steaming; [positive] No visible seat wear, abrasion, or thinning in high-wear areas.","front":"Issues: [minor] General wrinkling and creasing across the fabric surface from storage/folding (Throughout both legs and waist area). Signals: [positive] Fabric surface appears clean with no visible stains or soiling; [positive] Color is even and consistent with no fading or discoloration; [positive] No visible pilling on fabric surface; [positive] Seams appear intact and well-constructed throughout; [positive] Drawstring appears intact with metal aglets present; [positive] Ribbed ankle cuffs appear in good shape with no stretching or damage; [positive] Elastic waistband appears to retain structure; [neutral] Light wrinkling present suggesting the garment has been worn and/or stored folded; [positive] No holes, tears, or structural damage visible.","label":"Issues: None. Signals: [positive] Label text is crisp, clean, and fully legible with no fading or fraying; [positive] Waistband elastic appears intact with no stretching or deformation visible; [positive] Fabric color is uniform teal/slate green with no visible staining or discoloration; [positive] Drawstring appears clean and undamaged; [positive] No visible pilling, snags, or abrasion on the waistband fabric visible in this shot; [positive] Label is sewn cleanly with no signs of attempted removal or fraying at edges.","detail":"Issues: [minor] Wrinkles and creases from folding/bunching (Body of garment, visible throughout the folded fabric). Signals: [positive] Seam stitching appears intact and even with no visible unraveling or splitting; [positive] Fabric surface shows no visible pilling, abrasion, or thinning; [positive] No stains, discoloration, or soiling visible on fabric; [positive] Brand label (Vuori) is clean, intact, and securely attached; [positive] Fabric color appears consistent and even with no fading; [neutral] Garment is heavily wrinkled/bunched from folding, obscuring full assessment; [neutral] Only a partial view of the garment is shown — full condition cannot be confirmed.","label_2":"Issues: [minor] Minor wrinkles/creasing visible on the garment fabric near the waistband area (Waistband/interior area visible above the label). Signals: [positive] Care label is clean, intact, and fully legible with no staining or damage; [positive] Label text is clear and unfrayed at edges; [positive] Fabric visible above label appears clean with consistent color and no visible staining; [neutral] Minor wrinkling visible in the bunched fabric above the label — consistent with normal handling; [positive] Blue thread/pin visible at top right edge — likely a tagging pin, suggesting possible NWT or recently tagged status; [neutral] This is a secondary care/content label only — full garment condition cannot be assessed from this image alone.","defects_summary":"[minor] General wrinkles and creasing across the garment from storage and folding at Throughout garment — front and back panels, legs, and waistband area — Negligible; fully reversible with washing or steaming and does not lower the grade meaningfully","measurement_waist":"Issues: [minor] Light surface wrinkles across the front panel of the waistband area (Front waistband and upper front panel). Signals: [positive] Fabric surface appears clean with no visible stains or soiling; [positive] Waistband elastic appears intact and not stretched out — gathers evenly; [positive] Drawstring cord is present, intact, and both aglets are in good condition; [positive] Fabric shows no visible pilling, abrasion, or thinning; [positive] Seams visible at waistband appear tight and unbroken; [positive] Color appears uniform with no fading or discoloration; [neutral] Minor wrinkles present from storage/folding — fully reversible; [neutral] Measurement shot provides scale reference — waist measures approximately 15 inches flat (30 inches circumference).","measurement_inseam":"Issues: [minor] Light wrinkles and creases across the leg panel (Along the leg panel, visible across the fabric surface). Signals: [positive] Fabric surface appears smooth and uniform with no visible pilling or abrasion; [positive] Color is consistent teal/slate green with no visible fading or discoloration; [positive] Ribbed cuff at hem appears intact and well-formed with no stretching or unraveling; [positive] Side seam appears clean and intact along the full visible length; [neutral] Minor wrinkles present but consistent with storage/folding, not wear damage; [neutral] Measurement shot provides scale reference — inseam approximately 25–26 inches visible; [positive] No visible stains, holes, snags, or pulls detected on the visible panel.","style_attributes_summary":"Elastic waistband with gathered/ruched texture (Waistband); Woven flat drawstring with metal aglets (Waistband drawstring channel); Ribbed cuff ankles (jogger style) (Both ankle cuffs); Side slash pockets (Both sides of hip/waist); Flatlock or serged side seam construction (Outer leg seams); Heathered sage/teal-green colorway with subtle texture (Entire garment); Small woven Vuori brand label patch (Side seam, lower torso/hip area)"}'::jsonb, '0.60', 'claude-sonnet-4-6|composite_v4', 'f3b8cd65-35b0-5ee1-8c56-84fafce21e3b', '2026-06-26 02:44:21.800561+00', false, false, '[{"defect":"General wrinkles and creasing across the garment from storage and folding","area_pct":30,"location":"Throughout garment — front and back panels, legs, and waistband area","severity":"minor","defect_type":"wrinkle_crease","size_bucket":"extensive","repairability":"reversible","impact_on_grade":"Negligible; fully reversible with washing or steaming and does not lower the grade meaningfully"}]'::jsonb, '[{"location":"Waistband","attribute":"Elastic waistband with gathered/ruched texture","confidence":0.98},{"location":"Waistband drawstring channel","attribute":"Woven flat drawstring with metal aglets","confidence":0.97},{"location":"Both ankle cuffs","attribute":"Ribbed cuff ankles (jogger style)","confidence":0.98},{"location":"Both sides of hip/waist","attribute":"Side slash pockets","confidence":0.95},{"location":"Outer leg seams","attribute":"Flatlock or serged side seam construction","confidence":0.9},{"location":"Entire garment","attribute":"Heathered sage/teal-green colorway with subtle texture","confidence":0.95},{"location":"Side seam, lower torso/hip area","attribute":"Small woven Vuori brand label patch","confidence":0.97}]'::jsonb, 'This is a pair of Vuori women''s jogger-style sweatpants in a heathered sage/teal-green colorway, size M, constructed from a recycled polyester-elastane blend with a soft, stretchy hand. The garment features an elasticized waistband with a woven flat drawstring finished with metal aglets, side slash pockets at the hip, flatlock or serged side seam construction, and ribbed cuffs at the ankle for a tapered jogger silhouette. Across seven images covering the front, back, label, detail, and measurement views, the fabric surface shows no visible pilling, staining, abrasion, thinning, or fading — color is consistent and even throughout. All seams appear tight and intact, the waistband elastic retains its structure and gathers evenly, and the drawstring and aglets are present and undamaged. The only cosmetic note is ordinary storage wrinkles that will resolve with a wash or steam. This garment earns an Excellent grade because it shows minimal signs of use with no functional or structural defects detected across any image.'),
('11f10235-274c-554b-9662-713a97c628f8', 'd5acf3a3-c4d0-56f2-9067-d3b2ac6b0691', '8.0', 'Excellent', '8.5', '8.5', '8.0', '8.0', '7.0', 'These Lululemon men''s performance chino shorts present in excellent used condition with strong fabric integrity and clean construction throughout. The fabric surface is uniformly colored with no visible staining, pilling, fading, or abrasion across front, back, and detail views. The sole genuine defect is minor surface scratching and tarnishing on the metal waistband button, a small permanent cosmetic flaw that does not affect function. Odor and cleanliness cannot be fully assessed from imagery, so that factor is held at a neutral baseline.', '{"back":"Issues: [minor] General wrinkles and creases from folding/laying flat (seat and leg panels, overall back). Signals: [positive] Fabric surface appears clean with no visible stains; [positive] Color is uniform with no fading or discoloration; [positive] Seams appear intact and well-constructed throughout; [positive] Waistband retains its shape with no stretching or distortion; [positive] Hem appears clean and finished without fraying; [positive] Back pockets appear structurally sound; [positive] No visible pilling or abrasion on seat or leg panels; [neutral] Minor wrinkles present from storage/laying flat; [positive] No visible seat wear or crotch seam stress.","front":"Issues: [minor] Light surface wrinkles across the front panel (Front panel, center and lower sections). Signals: [positive] Fabric surface appears clean with no visible stains; [positive] Color is uniform and consistent with no fading or discoloration; [positive] Seams appear intact and well-constructed throughout; [positive] Button closure appears intact and functional; [positive] Zipper pull on side pocket is present and appears functional; [positive] Hem is clean and finished with no fraying or unraveling; [positive] No visible pilling or abrasion on fabric surface; [positive] Garment retains its shape well with no stretching or misshaping; [neutral] Minor wrinkles present from storage/folding but easily reversible.","label":"Issues: None. Signals: [positive] Fabric surface appears clean with no visible staining or soiling; [positive] Lululemon brand label is intact, well-attached, and legible; [positive] Stitching on waistband and pocket seams appears tight and uniform with no loose threads; [positive] Fabric texture is consistent across the visible panel with no pilling or abrasion; [positive] Color is even and consistent with no fading or discoloration visible; [positive] Belt loop appears structurally sound with no fraying; [neutral] Only a partial view of the garment is shown — full condition cannot be assessed; [neutral] Slight sheen variation visible on waistband may indicate minor fabric compression from folding, not wear damage.","detail":"Issues: [minor] Scratched and tarnished metal button with visible surface wear marks (Waistband button/fly closure area, center-front); [minor] Light soiling or discoloration on fabric near button area (Fly panel, just above and around the button); [minor] Slight wrinkling and creasing in the fly panel and waistband area (Fly panel and lower waistband). Signals: [positive] Fabric weave appears intact with no holes, tears, or significant abrasion visible; [positive] Stitching on fly panel and pocket seams appears clean and secure; [positive] Button is present and functional, properly seated in buttonhole; [negative] Metal button shows surface scratching and tarnishing consistent with use; [negative] Minor wrinkling present suggesting the garment has been worn and not freshly pressed; [negative] Slight discoloration near button area, possibly from handling or light soiling; [positive] Overall fabric appears clean with good color retention.","label_2":"Issues: [minor] Wrinkles and creases visible on the dark lining fabric (Interior lining/sweatband area). Signals: [positive] Interior lining fabric appears clean with no visible staining or soiling; [positive] Fabric weave of lining is intact with no visible damage or wear-through; [neutral] Circular grading/inventory sticker present and legible, suggesting professional consignment processing; [neutral] Minor wrinkles in lining fabric, consistent with normal storage; [positive] Exterior tan fabric visible at edge appears clean and structurally sound; [neutral] Limited view — only interior lining and partial exterior edge visible; full garment condition cannot be assessed.","defects_summary":"[minor] Surface scratching and tarnishing on the metal waistband button at Center-front waistband button/fly closure — Minor cosmetic deduction to cosmetic appearance score; no functional impact; [minor] Light surface wrinkles and creases across front and back panels from storage/folding at Front and back fabric panels overall — Negligible — fully reversible with steaming or pressing; no grade impact","measurement_waist":"Issues: [minor] Light wrinkles/creases across the front panel, likely from storage or folding (front center panel, below waistband). Signals: [positive] Fabric surface appears clean with no visible stains or soiling; [positive] Color is uniform and consistent with no fading or discoloration; [positive] Waistband and belt loops appear intact and well-structured; [positive] Button closure appears present and intact; [positive] Fabric has a smooth, unworn appearance with no pilling or abrasion; [positive] Side zip pocket hardware visible and appears intact; [neutral] Minor surface wrinkles present but easily reversible; [neutral] This is a measurement/partial shot — hem, inseam, and back panel not visible.","measurement_length":"Issues: [minor] Light wrinkles and creases across the fabric panel (Main fabric panel, upper and mid section). Signals: [positive] Fabric surface appears clean with no visible stains or soiling; [positive] No visible pilling, abrasion, or thinning on the fabric panel; [positive] Fabric color is uniform with no fading or discoloration; [positive] Seams appear intact and well-constructed; [positive] Hem stitching is clean and even; [neutral] Light wrinkles present but easily reversible; [neutral] Measurement shot provides scale reference but limits full garment assessment.","style_attributes_summary":"Flat-front chino/performance styling with fly panel topstitching (Center front); Metal shank button closure on fly (Center-front waistband); Side zip security/media pocket with metal zipper pull (Right hip/side seam); Welt/jetted back pockets with button closure (Left and right back panels); Belt loops integrated into structured waistband (Waistband); Clean finished hem with topstitching (Bottom hem of both legs); Dark navy/charcoal interior lining fabric (Interior of garment); Lululemon logo patch label sewn onto waistband interior (Waistband interior, center-left); Slim/tailored chino cut in lightweight synthetic performance fabric (Overall garment)"}'::jsonb, '0.60', 'claude-sonnet-4-6|composite_v4', '1a5814e6-cd59-51ce-becf-649d1f0e6d91', '2026-06-25 21:43:40.168321+00', false, false, '[{"defect":"Surface scratching and tarnishing on the metal waistband button","area_pct":null,"location":"Center-front waistband button/fly closure","severity":"minor","defect_type":"other","size_bucket":"small","repairability":"permanent","impact_on_grade":"Minor cosmetic deduction to cosmetic appearance score; no functional impact"},{"defect":"Light surface wrinkles and creases across front and back panels from storage/folding","area_pct":20,"location":"Front and back fabric panels overall","severity":"minor","defect_type":"wrinkle_crease","size_bucket":"extensive","repairability":"reversible","impact_on_grade":"Negligible — fully reversible with steaming or pressing; no grade impact"}]'::jsonb, '[{"location":"Center front","attribute":"Flat-front chino/performance styling with fly panel topstitching","confidence":0.98},{"location":"Center-front waistband","attribute":"Metal shank button closure on fly","confidence":0.97},{"location":"Right hip/side seam","attribute":"Side zip security/media pocket with metal zipper pull","confidence":0.95},{"location":"Left and right back panels","attribute":"Welt/jetted back pockets with button closure","confidence":0.95},{"location":"Waistband","attribute":"Belt loops integrated into structured waistband","confidence":0.98},{"location":"Bottom hem of both legs","attribute":"Clean finished hem with topstitching","confidence":0.97},{"location":"Interior of garment","attribute":"Dark navy/charcoal interior lining fabric","confidence":0.9},{"location":"Waistband interior, center-left","attribute":"Lululemon logo patch label sewn onto waistband interior","confidence":0.97},{"location":"Overall garment","attribute":"Slim/tailored chino cut in lightweight synthetic performance fabric","confidence":0.95}]'::jsonb, 'These are Lululemon men''s flat-front performance chino shorts in a khaki/tan colorway, featuring a structured waistband with belt loops, a button-and-zip fly closure, a side zip pocket, and welt back pockets. The lightweight woven synthetic fabric shows no visible staining, pilling, abrasion, or fading across all photographed panels — front, back, interior lining, and hem all appear clean and intact. Seams and stitching are tight and uniform throughout, the hem is cleanly finished, and the garment retains its original shape without stretching or distortion. The only noted flaw is minor surface scratching and tarnishing on the metal shank button at the waistband, consistent with normal use and purely cosmetic in nature. All functional elements — zipper, button, pockets, and belt loops — appear present and operational. Light storage wrinkles are visible but fully reversible with a press or steam. Overall, this is a well-maintained pair of shorts that earns an Excellent grade, showing only the lightest signs of prior wear.'),
('228afcb6-05d7-5aa7-866d-b12f9bb46510', '4a2fdcc3-0026-596e-b824-f4e8b6949339', '7.0', 'Very Good', '7.0', '7.5', '7.0', '7.0', '7.0', 'This Magaschoni 100% cashmere wrap cardigan presents in Very Good pre-owned condition. The garment retains its original shape, color consistency, and structural integrity with all seams and ribbed trims intact. Light surface pilling is distributed across the front and back body panels — characteristic of cashmere wear — and minor loose threads are noted at the hem and label edge. No stains, holes, fading of significance, or functional failures were detected across the image set.', '{"back":"Issues: [minor] Light surface fuzz/pilling visible across the back panel, consistent with moderate wear of a knit sweater (Center and lower back panel); [minor] Loose fiber/lint debris visible on back surface (Upper back panel and mid-back); [minor] Slight wrinkling/creasing across the back panel from hanging or storage (Mid to lower back panel). Signals: [positive] Fabric structure appears intact with no visible holes, tears, or seam failures; [positive] Color appears even and consistent across the back panel with no significant fading or discoloration; [positive] Ribbed collar, hem, and cuffs appear to retain their shape without significant stretching; [negative] Light surface fuzz/pilling present indicating moderate use; [negative] Loose lint/fiber debris on surface suggesting recent wear without cleaning; [positive] No visible staining or odor indicators on the back panel; [positive] Seams appear intact and well-constructed.","front":"Issues: [minor] Light surface pilling visible on front body panels (Front body, scattered across chest and torso area); [minor] Minor lint/fuzz accumulation on fabric surface (Front body panels generally); [minor] Slight wrinkling/creasing from storage or hanging (Front body and wrap collar area). Signals: [positive] Color is consistent and even across the entire garment with no significant fading; [positive] No visible stains or discoloration detected; [positive] Seams appear intact and well-constructed throughout; [positive] Cuffs show no significant stretching or wear; [positive] Hem appears intact with no unraveling; [positive] Garment retains its original shape well; [negative] Light surface pilling present on front body panels indicating some wear; [negative] Minor lint/fuzz on surface suggesting regular use; [positive] Overall garment presents in good used condition with minimal wear signs.","label":"Issues: [moderate] Loose thread visible at bottom edge of brand label (Bottom edge of Magaschoni Cashmere brand label); [minor] Light surface fuzz/pilling visible on cashmere fabric surrounding the label (Fabric surface visible around the label area). Signals: [positive] Brand label text (Magaschoni Cashmere) is clearly legible and intact; [positive] Size tag (M) is present and fully readable; [positive] Country of origin tag (Made in China / Fabriqué en Chine) is intact and legible; [positive] Label stitching appears mostly secure with only minor thread loosening; [negative] Light surface pilling on cashmere fabric visible around label area, consistent with some wear; [positive] Cashmere fabric appears intact with no visible holes or major damage in the visible area; [neutral] Image is a close-up label shot; full garment condition cannot be fully assessed.","detail":"Issues: [moderate] Visible surface pilling/fuzz on cashmere fabric visible around the label area (fabric surface surrounding the care label, visible across the frame). Signals: [positive] 100% cashmere composition confirmed on care label — premium material; [positive] Care label is clean, intact, and fully legible with no staining or damage; [positive] Label stitching appears secure and well-attached; [negative] Visible surface pilling/fuzz on the cashmere fabric around the label area suggests the garment has been worn and washed; [positive] Dark charcoal/dark grey color is consistent with no obvious fading visible in this shot; [negative] Fabric texture shows some fiber lift consistent with cashmere wear, indicating use beyond new condition.","defects_summary":"[minor] Light surface pilling distributed across front and back body panels at Front and back body panels, scattered — Modest downward pressure on fabric condition and cosmetic appearance; characteristic of cashmere wear and easily addressed with a fabric shaver; [minor] Slight fraying/loose threads at bottom hem edge at Bottom hem, center-left area — Minor impact on structural integrity score; repairable with simple re-stitching; [minor] Loose thread at bottom edge of brand label at Interior brand label, bottom edge — Negligible cosmetic impact; does not affect wearability","measurement_chest":"Issues: [minor] Light surface pilling visible across the body of the sweater, particularly on the front panel (Front body panel); [minor] Slight fraying or loose threads visible along the bottom hem edge (Bottom hem, center-left area); [minor] Minor lint and debris accumulation on fabric surface (Overall front surface). Signals: [positive] Overall color is consistent with no significant fading or discoloration; [positive] Fabric structure appears intact with no major holes or tears; [positive] Shawl collar and wrap design appear to retain their shape well; [negative] Light surface pilling present on front body panel indicating moderate use; [negative] Minor lint and debris on surface suggesting normal wear; [negative] Slight fraying at bottom hem edge; [neutral] Tape measure reference allows accurate size assessment — approximately 21 inches pit-to-pit; [positive] Brand label (Magaschoni) visible at neckline, garment is identifiable.","measurement_length":"Issues: [minor] Light surface pilling visible on the main body fabric (front body panel, left side); [minor] Subtle lighter tonal variation/slight fading on left side of body compared to right (front body panel, left side); [minor] Mild wrinkling and creasing across the body panel (front body panel, overall). Signals: [positive] Fabric appears intact with no visible holes, tears, or major structural damage; [positive] Color is a consistent dark brown/charcoal with no major discoloration or staining visible; [positive] Ribbed hem band appears intact and not stretched out; [negative] Minor surface pilling present on body fabric indicating some wear; [negative] Slight tonal variation on left side may indicate mild fading from washing; [neutral] Measurement shot provides good scale reference — garment appears to be approximately 25–26 inches in body length; [neutral] Garment is laid flat and partially visible; full condition assessment limited to this panel view.","style_attributes_summary":"Wrap-front crossover open design with extended shawl/scarf collar (Neckline and front closure); Ribbed knit collar and wrap band contrasting with smoother main body knit (Collar and wrap band); Ribbed cuffs (Sleeve ends); Ribbed hem band (Bottom hem); Relaxed, slightly boxy silhouette with long sleeves (Overall garment); 100% cashmere knit construction with characteristic soft, slightly fuzzy surface texture (Entire garment)"}'::jsonb, '0.60', 'claude-sonnet-4-6|composite_v4', 'ef2d3efc-f91f-52d7-b2ba-80e63514c24c', '2026-06-26 00:36:15.347626+00', false, false, '[{"defect":"Light surface pilling distributed across front and back body panels","area_pct":25,"location":"Front and back body panels, scattered","severity":"minor","defect_type":"pilling","size_bucket":"extensive","repairability":"reversible","impact_on_grade":"Modest downward pressure on fabric condition and cosmetic appearance; characteristic of cashmere wear and easily addressed with a fabric shaver"},{"defect":"Slight fraying/loose threads at bottom hem edge","area_pct":null,"location":"Bottom hem, center-left area","severity":"minor","defect_type":"seam_failure_unthreading","size_bucket":"medium","repairability":"repairable","impact_on_grade":"Minor impact on structural integrity score; repairable with simple re-stitching"},{"defect":"Loose thread at bottom edge of brand label","area_pct":null,"location":"Interior brand label, bottom edge","severity":"minor","defect_type":"seam_failure_unthreading","size_bucket":"small","repairability":"repairable","impact_on_grade":"Negligible cosmetic impact; does not affect wearability"}]'::jsonb, '[{"location":"Neckline and front closure","attribute":"Wrap-front crossover open design with extended shawl/scarf collar","confidence":0.95},{"location":"Collar and wrap band","attribute":"Ribbed knit collar and wrap band contrasting with smoother main body knit","confidence":0.92},{"location":"Sleeve ends","attribute":"Ribbed cuffs","confidence":0.95},{"location":"Bottom hem","attribute":"Ribbed hem band","confidence":0.95},{"location":"Overall garment","attribute":"Relaxed, slightly boxy silhouette with long sleeves","confidence":0.9},{"location":"Entire garment","attribute":"100% cashmere knit construction with characteristic soft, slightly fuzzy surface texture","confidence":0.95}]'::jsonb, 'This is a Magaschoni 100% cashmere wrap-style cardigan in a rich dark brown/charcoal colorway, size M. The open-front wrap silhouette features a shawl/crossover collar with ribbed knit detailing, long sleeves with ribbed cuffs, and a ribbed hem band — all of which retain their shape well with no significant stretching or distortion. The garment earns a Very Good grade because it shows clear signs of prior wear without any major damage: light surface pilling is visible across the front and back body panels (typical of cashmere use), and minor loose threads are present at the bottom hem edge and the brand label. Color is even and consistent throughout with no notable fading or staining, and the fabric structure is fully intact with no holes or tears. Functional elements cannot be fully assessed from the images, but no closures or hardware issues were observed. Overall, this is a presentable, wearable cashmere piece that would benefit from a light de-pilling treatment before use.');

