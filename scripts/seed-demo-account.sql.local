('e0ed5c92-71ca-570e-b31f-e01c3b609132', 'd54d2cc8-aa82-4a95-ad3b-e899d7a83454', 'Lululemon Women''s Gray Floral Jacquard Quarter-Zip Long Sleeve Pullover', 'Lululemon', NULL, NULL, '6', 'Gray', NULL, NULL, 'Goodwill Outlet Bins — June', NULL, 'cataloged', NULL, NULL, NULL, 'clothing', '7e119e67-4f93-542a-9f12-338dd40bb153', NULL, '22', '{"chest":15,"length":26}'::jsonb, NULL, NULL, NULL, NULL, NULL, 'Quarter-Zip Pullover', 'Lululemon women''s long-sleeve quarter-zip pullover in light gray. Features an all-over tonal floral jacquard texture, ribbed collar, ribbed cuffs and hem, raglan sleeves, and thumb holes. The lululemon logo zipper pull is intact. Garment is clean with no visible staining or pilling. Note: there is a small seam separation/gap at the left sleeve thumb hole opening — minor flaw, shown in photos.', '[]'::jsonb, '53159', '{"Size":["S"],"Type":["Quarter-Zip Pullover"],"Brand":["Lululemon"],"Color":["Gray"],"Style":["Athletic"],"Season":["Fall","Winter"],"Closure":["Quarter Zip"],"Pattern":["Floral Jacquard"],"Vintage":["No"],"Features":["Thumb Holes","Quarter Zip","Ribbed Cuffs","Ribbed Hem"],"Handmade":["No"],"Neckline":["Mock Neck"],"Occasion":["Activewear","Casual"],"Size Type":["Regular"],"Department":["Women"],"Personalize":["No"],"Sleeve Type":["Raglan"],"Sleeve Length":["Long Sleeve"]}'::jsonb, '2026-06-17 02:33:52.20615+00'),
