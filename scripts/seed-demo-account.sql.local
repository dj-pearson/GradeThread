('377f5618-6ae8-50e1-8f59-8197dc1caf4f', 'd54d2cc8-aa82-4a95-ad3b-e899d7a83454', 'Vuori Women''s Jogger Sweatpants Size M Gray Recycled Polyester Drawstring', 'Vuori', 'bottoms', 'pants', 'M', 'Gray', NULL, NULL, 'Goodwill Outlet Bins — June', NULL, 'listed', '7ee5c530-c957-5b87-9a1e-fc33bf4ff0ec', 'dc317246-14a3-56ce-a1e0-c5099575ec6c', 'FD-dc0c30ed', 'clothing', '7e119e67-4f93-542a-9f12-338dd40bb153', '45.50', NULL, '{"waist":14,"inseam":27}'::jsonb, '89% Recycled Polyester, 11% Elastane', '8.5', 'Excellent', 'https://gradethread.com/cert/f3b8cd65-35b0-5ee1-8c56-84fafce21e3b', NULL, 'VW303', 'Vuori jogger-style sweatpants in a heathered gray colorway. Made from 89% recycled polyester and 11% elastane for a soft, stretchy feel. Features an elasticized waistband with a woven drawstring and ribbed ankle cuffs. Size M. Manufactured in Vietnam. Item appears in good used condition with no visible damage, staining, or heavy wear noted in the photos.', '[]'::jsonb, '260954', '{"Fit":["Relaxed"],"MPN":["VW303"],"Size":["M"],"Type":["VW303"],"Brand":["Vuori"],"Color":["Gray"],"Style":["Jogger"],"Inseam":["27 in"],"Closure":["Drawstring"],"Pattern":["Solid"],"Features":["Drawstring Waist","Elastic Waistband","Ribbed Cuffs","Recycled Materials"],"Handmade":["No"],"Material":["89% Recycled Polyester","11% Elastane"],"Occasion":["Activewear","Casual"],"Leg Style":["Jogger"],"Size Type":["Regular"],"Department":["Women"],"Waist Size":["14 in (flat, unstretched)"],"Fabric Type":["89% Recycled Polyester, 11% Elastane"],"Personalize":["No"],"Performance/Activity":["Yoga","Running","General Fitness"]}'::jsonb, '2026-06-23 01:11:19.626535+00'),
('b8bd2e56-0514-5639-b6a5-58ec94dc0ee2', 'd54d2cc8-aa82-4a95-ad3b-e899d7a83454', 'ME+EM White Tonal Stripe Pintuck Long-Sleeve Shirt — UK 8 / US S / EU 36', 'ME+EM', NULL, NULL, 'S', 'White', '5.1', NULL, 'Westwood Estate Sale', NULL, 'drafted', NULL, NULL, 'FD-62c0018a', 'clothing', 'fc8cd104-dcdc-56c2-baed-e725eecc5260', '87.50', NULL, '{"chest":20,"length":27}'::jsonb, 'Cotton', NULL, NULL, NULL, NULL, 'Long-sleeve button-up shirt with tonal stripe, pintuck front detail, and double cuffs', 'Classic ME+EM long-sleeve button-up shirt in crisp white with a subtle tonal stripe and elegant pintuck detail at the front. Features a spread collar, double/French cuffs, and a curved hem. Made in Turkey; care label advises gentle machine wash or dry clean.

• Brand: ME+EM
• Size: UK 8 / US S / EU 36
• Color: White
• Style: Tonal stripe, pintuck front, double cuffs
• Measured flat: ~20" chest (pit-to-pit), ~27" length

Condition: Good pre-owned condition. No visible stains or damage; light storage creasing only.', '[]'::jsonb, '53159', '{"Size":["S (UK 8 / US S / EU 36)"],"Type":["Shirt"],"Brand":["ME+EM"],"Color":["White"],"Style":["Button-Down Shirt"],"Season":["Fall","Spring","Winter"],"Accents":["Pintuck"],"Closure":["Button"],"Pattern":["Tonal Stripe"],"Vintage":["No"],"Handmade":["No"],"Material":["Cotton"],"Neckline":["Collared"],"Occasion":["Work","Casual","Smart Casual"],"Size Type":["Regular"],"Department":["Women"],"Fabric Type":["Cotton"],"Sleeve Type":["Double Cuff"],"Garment Care":["Gentle Machine Wash or Dry Clean, Wash With Similar Colours"],"Sleeve Length":["Long Sleeve"]}'::jsonb, '2026-06-13 12:08:43.972226+00'),
('feb73f15-70ea-5ef6-97be-61003813752f', 'd54d2cc8-aa82-4a95-ad3b-e899d7a83454', 'Lululemon Men''s Khaki Chino Shorts Size 33', 'Lululemon', 'bottoms', 'shorts', '33', 'Khaki', '5.5', NULL, 'Goodwill Outlet Bins — June', NULL, 'listed', 'd5acf3a3-c4d0-56f2-9067-d3b2ac6b0691', '11f10235-274c-554b-9662-713a97c628f8', '750', 'clothing', '7e119e67-4f93-542a-9f12-338dd40bb153', '41.50', NULL, '{"waist":17.5,"inseam":10}'::jsonb, 'Synthetic / Performance Fabric', '8.0', 'Excellent', 'https://gradethread.com/cert/1a5814e6-cd59-51ce-becf-649d1f0e6d91', '22', 'Chino / Golf Short', 'Lululemon men''s performance chino shorts in khaki/tan. Size 33 waist. Features a smooth, lightweight synthetic performance fabric, flat-front styling, button-and-zip fly closure, two front slash pockets, two back welt pockets, and belt loops. Great for golf, travel, or everyday wear.

