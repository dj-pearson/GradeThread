('8519c641-3f62-5373-b7e1-f01d44185341', 'd54d2cc8-aa82-4a95-ad3b-e899d7a83454', 'Magashoni 100% Cashmere Wrap Belted Cardigan Sweater – Dark Brown', 'Magashoni', 'tops', 'sweater', 'medium', 'Brown', NULL, NULL, 'Westwood Estate Sale', NULL, 'drafted', '4a2fdcc3-0026-596e-b824-f4e8b6949339', '228afcb6-05d7-5aa7-866d-b12f9bb46510', 'FD-3cd1d0ec', 'clothing', 'fc8cd104-dcdc-56c2-baed-e725eecc5260', '62.50', NULL, '{"chest":19,"length":24}'::jsonb, '100% Cashmere', '7.0', 'Very Good', 'https://gradethread.com/cert/ef2d3efc-f91f-52d7-b2ba-80e63514c24c', NULL, 'Wrap / Belted Cardigan', 'Luxurious 100% cashmere wrap-style cardigan sweater in a rich dark brown. Features a self-tie belt, long sleeves with ribbed cuffs, and a ribbed hem. The open-front wrap silhouette gives it a relaxed, elegant drape. Care label reads RN 86804 / CA 30427 — 100% Cashmere; hand wash in cold water with mild detergent, towel dry, reshape and lay flat; iron on mild heat or dry clean. Condition: pre-owned with light general wear; some lint/pilling visible on the surface consistent with cashmere use. No major damage noted.', '[]'::jsonb, '63866', '{"MPN":["RN 86804","CA 30427"],"Size":["M"],"Type":["Sweater"],"Brand":["Magashoni"],"Color":["Dark Brown"],"Style":["Wrap Cardigan"],"Season":["Fall","Winter"],"Pattern":["Solid"],"Vintage":["No"],"Features":["Belted","Wrap Style"],"Material":["Cashmere"],"Neckline":["V-Neck"],"Occasion":["Casual","Work"],"Size Type":["Regular"],"Department":["Women"],"Fabric Type":["100% Cashmere"],"Personalize":["No"],"Garment Care":["Turn Inside Out, Hand Wash With Mild Detergent In Cold Water, Towel Dry, Reshape And Lay Flat, Iron In Mild Heat Or Dry Clean"],"Sleeve Length":["Long Sleeve"]}'::jsonb, '2026-06-22 22:44:52.341245+00'),
