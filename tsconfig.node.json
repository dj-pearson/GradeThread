{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsBuildInfo",
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    // US-2106: vite.config.ts imports the SEO/grading constants directly to emit
    // dist/llms-full-data.json, and that chain reaches modules using the "@/"
    // alias (grading-scale → json-ld → @/lib/constants). Without this mapping
    // the build fails to resolve them here even though the app config has it.
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] }
  },
  // US-2629: vitest.config.ts was in no project either. It configures the suite
  // that gates every push, and a type error in it would surface as a confusing
  // vitest startup failure rather than as a compiler error.
  "include": ["vite.config.ts", "vitest.config.ts"]
}
