# Cloudflare Pages BUILD-TIME environment (production).
#
# Vite loads this file during `vite build` (mode=production), so these VITE_*
# values get baked into the React bundle on every Cloudflare Pages build —
# version-controlled, immune to the dashboard wipe that lost them. This is the
# correct home for build-time vars; wrangler.toml [vars] are runtime-only and
# CANNOT supply these (Cloudflare docs confirm).
#
# SAFE TO COMMIT: every VITE_* var is public by design — it ships in the browser
# JS bundle served from gradethread.com, so it's already world-readable.
# ⚠️  NEVER add a server secret here (Supabase service-role key, STRIPE_SECRET_KEY,
#     ANTHROPIC_API_KEY, STRIPE_WEBHOOK_SECRET, …). Those are NOT VITE_-prefixed
#     and live only in the edge service env / Pages secrets.
#
# Local `npm run dev` is unaffected — it runs in development mode and uses your
# own untracked .env / .env.local.

# Supabase (self-hosted). URL is public; the anon key is the publishable,
# RLS-protected key (safe in client bundles) — fill it in.
VITE_SUPABASE_URL=https://api.gradethread.com
VITE_SUPABASE_ANON_KEY=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJpc3MiOiJzdXBhYmFzZSIsImlhdCI6MTc3MTI3MjY2MCwiZXhwIjo0OTI2OTQ2MjYwLCJyb2xlIjoiYW5vbiJ9.mSUZpxhRmoVIjXO93vqgmG4g16o3y8umcGqQacoTrEc

# Stripe publishable key (pk_live_… / pk_test_…) — safe to expose.
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_51TbnygAbS8ZBP0vmJ6OiV6WaVvy4X9KkOsxXOwco5Ys8Pxj1YoCw4dsiN2ArRL4QbCzbxowrXCSWVeA3jCjt9GWy00foyvGT2n

# Sentry DSN — public by design.
VITE_SENTRY_DSN=https://b47d4db6e1c3ca9fe341082a86f86b59@o4510398791352320.ingest.us.sentry.io/4511508903362560

# PostHog (client) — project API key is public; host is fixed.
VITE_POSTHOG_KEY=phc_AVBLTHsPuNayLRtxiAJRU8QJZdt4F2kSr9Y7CFrxmEjx
# INGESTION host, not the UI URL. posthog-js appends /e/, /decide/, /s/ to this
# value, so https://us.posthog.com/project/464669 sends events to
# .../project/464669/e/ — which 302s to the web app instead of ingesting, and
# nothing ever arrives. https://us.posthog.com/project/464669 is where YOU read
# the data; this is where the browser WRITES it.
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Consolidated GradeThread + FlipDesk edge API.
VITE_EDGE_API_URL=https://functions.gradethread.com

# Cloudflare Image Resizing toggle — gates responsive/next-gen <Image>
# srcsets. (Same var name is read at runtime by the blog SSR — see wrangler.toml.)
# VERIFIED LIVE 2026-08-03: Transformations ARE enabled on this zone.
#   curl -sI "https://gradethread.com/cdn-cgi/image/width=320,format=auto/logo_primary.png"
#   -> HTTP/1.1 200 OK, Content-Type: image/avif  (125,781 B -> 5,420 B, -95.7%)
# The flag had been left "false" waiting on a dashboard step that was
# already done, so every image shipped full-size in its original format.
# WHAT MAKES THIS SAFE IS THE VERIFICATION ABOVE, NOT onerror=redirect.
# Those are different failure modes and conflating them is how this gets
# flipped on a zone where it does not work:
#   - zone toggle OFF -> /cdn-cgi/image/* 404s at the edge before any
#     transform runs, and a 404ing srcset candidate does NOT fall back to
#     src, so images render BROKEN site-wide (responsive-image.tsx says so).
#   - zone toggle ON but the SOURCE image errors -> onerror=redirect serves
#     the untransformed original. This is the only case that flag covers.
# So: never flip this true without curling a transform URL first.
VITE_CF_IMAGE_RESIZING=true

# Homepage sample-certificate card (US-1945 AC4). A REAL public cert uuid so the
# card links to a live /cert/<id> (returns 200) instead of falling back to
# signup — the buyer evaluating us sees an actual verifiable certificate. Any id
# from https://gradethread.com/sitemap-certs.xml is safe (that sitemap lists only
# published, indexable certs). This value was verified live: it renders
# Certificate No. GT-7Y3BCAF off /verified/pearson.
VITE_SAMPLE_CERTIFICATE_ID=cce9b573-6b29-45e3-ba45-7c0fe1578418